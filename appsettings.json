{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Set via environment variable ConnectionStrings__DefaultConnection or dotnet user-secrets"
  },
  "Integrations": {
    "ProceduresEndpoint": "Set via Integrations__ProceduresEndpoint",
    "ProceduresApiKey": "Set via Integrations__ProceduresApiKey",
    "ProceduresTimeoutSeconds": 5,
    "ProceduresRetryCount": 1,
    "NotificationEndpoint": "Set via Integrations__NotificationEndpoint",
    "NotificationApiKey": "Set via Integrations__NotificationApiKey",
    "NotificationTimeoutSeconds": 5,
    "AttachmentRoot": "Set via Integrations__AttachmentRoot (path outside wwwroot)",
    "AttachmentMaxBytes": 5242880,
    "AttachmentMaxCount": 2
  },
  "DataProtection": {
    "KeysPath": "Keys"
  }
}
