@using Ibtikar.Controllers
@using Ibtikar.Services.Helpers
@using Ibtikar.ViewModels
@using static Ibtikar.Services.Helpers.KsaTime
@model MyRequestDetailsVm
@{
    ViewData["Title"] = string.IsNullOrEmpty(Model.Reference) ? "تفاصيل المسودة" : $"تفاصيل الطلب {Model.Reference}";
    var isResubmittable = Model.StatusCode == IdeaStatusCodes.WaitingForCompletion;
    var isResubmittableForDevelopment = Model.StatusCode == IdeaStatusCodes.ReturnedForDevelopment;
    var isRejected = Model.StatusCode == IdeaStatusCodes.Rejected;
    var isClosedByTimeout = Model.StatusCode == IdeaStatusCodes.Cancelled;
    var isDraft = string.IsNullOrEmpty(Model.Reference);
}

<div class="bog-main">
    <div class="container py-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
            <h2 class="mb-0 d-flex align-items-center gap-2">
                <span class="bog-page-icon" aria-hidden="true">
                    <span class="material-icons">description</span>
                </span>
                تفاصيل الطلب
            </h2>
            <a class="btn btn-outline-secondary" asp-action="Index">
                <span class="material-icons align-middle" style="font-size:18px">arrow_forward</span>
                العودة إلى طلباتي
            </a>
        </div>

        <div class="card bog-section mb-3">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <strong>
                    @if (string.IsNullOrEmpty(Model.Reference))
                    {
                        <span class="text-muted">مسودة</span>
                    }
                    else
                    {
                        <code class="fs-6">@Model.Reference</code>
                    }
                </strong>
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <span class="badge rounded-pill" style="background-color:@Model.StatusColor">@Model.StatusName</span>
                    @if (Model.StatusCode == IdeaStatusCodes.New && !string.IsNullOrEmpty(Model.Reference))
                    {
                        <form method="post" asp-action="Delete" asp-route-id="@Model.Id" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger"
                                    data-confirm-trigger data-confirm-message="هل أنت متأكد من حذف هذا الطلب نهائياً؟">
                                <span class="material-icons align-middle" style="font-size:16px">delete</span>
                                حذف الطلب
                            </button>
                        </form>
                    }
                </div>
            </div>
            <div class="card-body">
                <h3 class="mb-3">@Model.Title</h3>

                <dl class="row mb-0">
                    <dt class="col-sm-3">المجال</dt>
                    <dd class="col-sm-9">@(Model.DomainName ?? "—")</dd>

                    <dt class="col-sm-3">التأثير المتوقع</dt>
                    <dd class="col-sm-9">
                        @(Model.ExpectedImpactName ?? "—")
                        @if (!string.IsNullOrWhiteSpace(Model.ExpectedImpactOther))
                        {
                            <span class="text-muted">(تفصيل: @Model.ExpectedImpactOther)</span>
                        }
                    </dd>

                    <dt class="col-sm-3">الفئة المستهدفة</dt>
                    <dd class="col-sm-9">
                        @(Model.TargetAudienceName ?? "—")
                        @if (!string.IsNullOrWhiteSpace(Model.TargetAudienceOther))
                        {
                            <span class="text-muted">(تفصيل: @Model.TargetAudienceOther)</span>
                        }
                    </dd>

                    <dt class="col-sm-3">تقنية حديثة</dt>
                    <dd class="col-sm-9">
                        @(Model.UsesEmergingTech
                            ? (string.IsNullOrWhiteSpace(Model.TechnologyOther) ? "نعم" : "نعم — " + Model.TechnologyOther)
                            : "لا")
                    </dd>

                    <dt class="col-sm-3">تاريخ التقديم</dt>
                    <dd class="col-sm-9" dir="ltr">
                        @((Model.SubmittedAt ?? Model.CreatedAt).FormatDateTime())
                    </dd>
                </dl>
            </div>
        </div>

        @if (isRejected && !string.IsNullOrWhiteSpace(Model.RejectionReason))
        {
            <div class="rejection-reason-box mb-3">
                <strong>سبب الرفض:</strong>
                <p class="mb-0 mt-2">@Model.RejectionReason</p>
            </div>
        }

        @if (isClosedByTimeout)
        {
            <div class="timeout-lock-box mb-3">
                <p class="mb-0 text-danger">انتهت المهلة المتاحة للتعديل، يرجى تقديم طلب جديد</p>
            </div>
        }

        <div class="card bog-section mb-3">
            <div class="card-header bg-white"><strong>وصف الفكرة</strong></div>
            <div class="card-body">
                <p class="mb-0" style="white-space:pre-line">@Model.Description</p>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.ProblemStatement))
        {
            <div class="card bog-section mb-3">
                <div class="card-header bg-white"><strong>المشكلة</strong></div>
                <div class="card-body">
                    <p class="mb-0" style="white-space:pre-line">@Model.ProblemStatement</p>
                </div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.ProposedSolution))
        {
            <div class="card bog-section mb-3">
                <div class="card-header bg-white"><strong>الحل المقترح</strong></div>
                <div class="card-body">
                    <p class="mb-0" style="white-space:pre-line">@Model.ProposedSolution</p>
                </div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.ExpectedBenefits))
        {
            <div class="card bog-section mb-3">
                <div class="card-header bg-white"><strong>الفوائد المتوقعة</strong></div>
                <div class="card-body">
                    <p class="mb-0" style="white-space:pre-line">@Model.ExpectedBenefits</p>
                </div>
            </div>
        }

        <div class="card bog-section mb-3">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <strong>المرفقات</strong>
                <span class="badge bg-secondary">@Model.Attachments.Count</span>
            </div>
            <div class="card-body p-0">
                @if (Model.Attachments.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var a in Model.Attachments)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span>
                                    <span class="material-icons align-middle text-danger" style="font-size:18px">picture_as_pdf</span>
                                    @a.FileName
                                </span>
                                <small class="text-muted" dir="ltr">
                                    @(a.SizeBytes / 1024) KB · @a.UploadedAt.FormatDateTime()
                                </small>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="text-muted text-center p-4">لا توجد مرفقات.</div>
                }
            </div>
        </div>

        @if (isDraft)
        {
            <div class="card bog-section mb-3">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <strong>المسودة</strong>
                    <a class="btn btn-primary"
                       asp-controller="Ideas" asp-action="Create" asp-route-draftId="@Model.Id">
                        <span class="material-icons align-middle" style="font-size:18px">edit</span>
                        متابعة وتعديل المسودة
                    </a>
                </div>
                <div class="card-body">
                    <p class="text-muted mb-2">يمكنك رفع المرفقات أو الاستمرار في تعديل بيانات المسودة قبل إرسالها.</p>
                    @await Component.InvokeAsync("IdeaAttachmentUploader", new { ideaId = Model.Id })
                </div>
            </div>
        }

        @if (isResubmittable)
        {
            <div class="card bog-section mb-3 border-warning">
                <div class="card-header bg-white"><strong>إعادة التقديم بعد الاستكمال</strong></div>
                <div class="card-body">
                    @if (!string.IsNullOrWhiteSpace(Model.CompletionNotes))
                    {
                        <div class="audit-notes-box mb-3">
                            <strong>ملاحظات التدقيق:</strong>
                            <p class="mb-0 mt-2">@Model.CompletionNotes</p>
                        </div>
                    }
                    <form method="post" asp-action="ResubmitCompletion" asp-route-id="@Model.Id" id="resubmitCompletionForm">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label" asp-for="Description">وصف الفكرة</label>
                            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" asp-for="ProblemStatement">المشكلة</label>
                            <textarea asp-for="ProblemStatement" class="form-control" rows="3"></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" asp-for="ProposedSolution">الحل المقترح</label>
                            <textarea asp-for="ProposedSolution" class="form-control" rows="3"></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" asp-for="ExpectedBenefits">الفوائد المتوقعة</label>
                            <textarea asp-for="ExpectedBenefits" class="form-control" rows="3"></textarea>
                        </div>
                        @await Component.InvokeAsync("IdeaAttachmentUploader", new { ideaId = Model.Id })
                        <button type="submit" class="btn btn-primary" id="resubmitCompletionBtn">
                            <span class="material-icons align-middle" style="font-size:18px">send</span>
                            إعادة التقديم
                        </button>
                    </form>
                </div>
            </div>
        }

        @if (isResubmittableForDevelopment)
        {
            <div class="card bog-section mb-3 border-primary">
                <div class="card-header bg-white"><strong>إعادة التطوير بعد ملاحظات اللجنة</strong></div>
                <div class="card-body">
                    @if (!string.IsNullOrWhiteSpace(Model.DevelopmentNotes))
                    {
                        <div class="alert alert-info mb-3" role="alert">
                            <strong>ملاحظات اللجنة:</strong>
                            <p class="mb-0 mt-2" style="white-space:pre-line">@Model.DevelopmentNotes</p>
                        </div>
                    }
                    <form method="post" asp-action="ResubmitDeveloped" asp-route-id="@Model.Id" id="resubmitDevelopedForm">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label" asp-for="Description">وصف الفكرة</label>
                            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" asp-for="ProblemStatement">المشكلة</label>
                            <textarea asp-for="ProblemStatement" class="form-control" rows="3"></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" asp-for="ProposedSolution">الحل المقترح</label>
                            <textarea asp-for="ProposedSolution" class="form-control" rows="3"></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" asp-for="ExpectedBenefits">الفوائد المتوقعة</label>
                            <textarea asp-for="ExpectedBenefits" class="form-control" rows="3"></textarea>
                        </div>
                        @await Component.InvokeAsync("IdeaAttachmentUploader", new { ideaId = Model.Id })
                        <button type="submit" class="btn btn-primary" id="resubmitDevelopedBtn">
                            <span class="material-icons align-middle" style="font-size:18px">send</span>
                            إعادة التطوير
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const forms = [
                { formId: 'resubmitCompletionForm', btnId: 'resubmitCompletionBtn' },
                { formId: 'resubmitDevelopedForm', btnId: 'resubmitDevelopedBtn' }
            ];
            for (const { formId, btnId } of forms) {
                const form = document.getElementById(formId);
                const btn = document.getElementById(btnId);
                if (form && btn) {
                    form.addEventListener('submit', function () {
                        btn.disabled = true;
                        btn.innerHTML = '<span class="spinner-border spinner-border-sm align-middle"></span> جاري الإرسال...';
                    });
                }
            }
        })();
    </script>
}