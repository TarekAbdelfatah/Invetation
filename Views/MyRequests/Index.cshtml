@using Ibtikar.Controllers
@using Ibtikar.Services.Helpers
@using Ibtikar.ViewModels
@using Microsoft.AspNetCore.Mvc.ViewFeatures
@using static Ibtikar.Services.Helpers.KsaTime
@model MyRequestsVm
@{
    ViewData["Title"] = "طلباتي";
    string[] stageLabels = { "التقديم", "التدقيق", "التقييم", "اللجنة", "التنفيذ" };
}

<div class="bog-main">
    <div class="container py-4">
        <div class="bog-page-header">
            <h1>
                <span class="bog-page-icon" aria-hidden="true">
                    <span class="material-icons">folder_special</span>
                </span>
                طلباتي
            </h1>
            <a class="btn btn-primary bog-form-actions-mobile" asp-controller="Ideas" asp-action="Create">
                <span class="material-icons align-middle" style="font-size:18px">add</span>
                <span class="d-none d-sm-inline">تقديم فكرة جديدة</span>
                <span class="d-inline d-sm-none">فكرة جديدة</span>
            </a>
        </div>

        <div class="card bog-section">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <strong>سجل الأفكار</strong>
                <span class="badge bg-secondary">@Model.TotalCount</span>
            </div>
            <div class="card-body p-0">
                @if (Model.Items.Any())
                {
                    <div class="bog-mobile-cards d-md-none">
                        @foreach (var i in Model.Items)
                        {
                            var stage = i.IsDraft ? 1 : IdeaProgress.StageFor(i.StatusCode);
                            var stageLabel = i.IsDraft ? "مسودة" : IdeaProgress.LabelFor(stage);
                            var percent = i.IsDraft ? 0 : IdeaProgress.PercentFor(stage);
                            <a class="bog-idea-card"
                               asp-controller="MyRequests" asp-action="Details" asp-route-id="@i.Id">
                                <div class="bog-idea-card__head">
                                    <span class="bog-idea-card__ref">
                                        @(string.IsNullOrEmpty(i.Reference) ? "مسودة" : i.Reference)
                                    </span>
                                    @if (i.IsDraft)
                                    {
                                        <span class="bog-idea-card__status" style="--chip-bg:#6c757d">
                                            <span class="bog-idea-card__status-dot" style="background-color:#6c757d"></span>
                                            مسودة
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="bog-idea-card__status"
                                              style="--chip-bg:@i.StatusColor">
                                            <span class="bog-idea-card__status-dot" style="background-color:@i.StatusColor"></span>
                                            @(i.StatusName ?? "—")
                                        </span>
                                    }
                                </div>

                                <h3 class="bog-idea-card__title">@i.Title</h3>
                                @if (!string.IsNullOrWhiteSpace(i.DomainName))
                                {
                                    <div class="bog-idea-card__meta small text-muted">
                                        <span class="material-icons align-middle" style="font-size:14px">category</span>
                                        @i.DomainName
                                    </div>
                                }

                                <div class="bog-idea-card__progress" aria-label="@stageLabel · @(percent)%">
                                    <div class="bog-idea-card__progress-track">
                                        @for (var s = 1; s <= IdeaProgress.TotalStages; s++)
                                        {
                                            var cls = s <= stage ? "bog-idea-card__progress-step --done" : "bog-idea-card__progress-step";
                                            <span class="@cls" title="@stageLabels[s - 1]"></span>
                                        }
                                    </div>
                                    <small class="bog-idea-card__progress-label">
                                        <span class="material-icons" style="font-size:13px">flag</span>
                                        @stageLabel · @(percent)%
                                    </small>
                                </div>

                                <div class="bog-idea-card__foot">
                                    <small class="bog-idea-card__date">
                                        <span class="material-icons" style="font-size:14px">event</span>
                                        @((i.SubmittedAt ?? i.CreatedAt).FormatDate())
                                    </small>
                                    <span class="bog-idea-card__chevron">
                                        عرض التفاصيل
                                        <span class="material-icons" style="font-size:18px">chevron_left</span>
                                    </span>
                                </div>
                            </a>
                        }
                    </div>

                    <div class="table-responsive d-none d-md-block">
                        <table class="bog-card-list">
                            <thead>
                                <tr>
                                    <th>المرجع</th>
                                    <th>العنوان</th>
                                    <th class="d-none d-lg-table-cell">المجال</th>
                                    <th>الحالة</th>
                                    <th class="d-none d-md-table-cell">المرحلة</th>
                                    <th class="d-none d-md-table-cell">تاريخ التقديم</th>
                                    <th class="text-end">إجراءات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var i in Model.Items)
                                {
                                    var stage = i.IsDraft ? 1 : IdeaProgress.StageFor(i.StatusCode);
                                    var stageLabel = i.IsDraft ? "مسودة" : IdeaProgress.LabelFor(stage);
                                    var percent = i.IsDraft ? 0 : IdeaProgress.PercentFor(stage);
                                    <tr>
                                        <td data-label="المرجع">
                                            @if (string.IsNullOrEmpty(i.Reference))
                                            {
                                                <span class="text-muted">مسودة</span>
                                            }
                                            else
                                            {
                                                <code>@i.Reference</code>
                                            }
                                        </td>
                                        <td data-label="العنوان">@i.Title</td>
                                        <td class="d-none d-lg-table-cell" data-label="المجال">
                                            @if (!string.IsNullOrWhiteSpace(i.DomainName))
                                            {
                                                <span class="badge bg-light text-dark border">@i.DomainName</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td data-label="الحالة">
                                            @if (i.IsDraft)
                                            {
                                                <span class="status-badge badge rounded-pill" style="background-color:#6c757d">مسودة</span>
                                            }
                                            else
                                            {
                                                <span class="status-badge badge rounded-pill" data-status-code="@i.StatusCode" style="background-color:@i.StatusColor">
                                                    @i.StatusName
                                                </span>
                                            }
                                        </td>
                                        <td class="d-none d-md-table-cell" data-label="المرحلة">
                                            <div class="idea-progress" data-idea-progress
                                                 data-stage="@stage"
                                                 data-stage-label="@stageLabel"
                                                 data-total-stages="@IdeaProgress.TotalStages"
                                                 role="group"
                                                 aria-label="مرحلة الفكرة">
                                                <div class="idea-progress__track" aria-hidden="true">
                                                    @for (var s = 1; s <= IdeaProgress.TotalStages; s++)
                                                    {
                                                        var cls = s <= stage ? "idea-progress__step idea-progress__step--done" : "idea-progress__step";
                                                        <div class="@cls" data-step="@s" title="@stageLabels[s - 1]"></div>
                                                    }
                                                </div>
                                                <small class="text-muted d-block mt-1">@stageLabel · @(percent)%</small>
                                            </div>
                                        </td>
                                        <td class="d-none d-md-table-cell" data-label="تاريخ التقديم"><small>@((i.SubmittedAt ?? i.CreatedAt).FormatDate())</small></td>
                                        <td class="text-end bog-card-list__actions" data-label="">
                                            <a class="btn btn-sm btn-outline-primary align-middle"
                                               asp-controller="MyRequests" asp-action="Details" asp-route-id="@i.Id"
                                               title="عرض تفاصيل الطلب">
                                                <span class="material-icons align-middle" style="font-size:16px">visibility</span>
                                                عرض
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center text-muted p-5">
                        <span class="material-icons" style="font-size:48px;color:var(--text-muted)">lightbulb</span>
                        <p class="mb-1 mt-2">لم تقدّم أي فكرة بعد.</p>
                        <a class="btn btn-primary" asp-controller="Ideas" asp-action="Create">
                            ابدأ بتقديم فكرتك الأولى
                        </a>
                    </div>
                }
            </div>
        </div>

        @await Html.PartialAsync("_Pagination", null,
            new ViewDataDictionary(ViewData)
            {
                { "Page", Model.Page },
                { "PageSize", Model.PageSize },
                { "TotalCount", Model.TotalCount }
            })
    </div>
</div>

@section Scripts {
    <script src="~/js/progress-bar.js" asp-append-version="true"></script>
}
