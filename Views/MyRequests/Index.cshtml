@using Ibtikar.Controllers
@using Ibtikar.Services.Ideas
@model MyRequestsVm
@{
    ViewData["Title"] = "طلباتي";
    string[] stageLabels = { "التقديم", "التدقيق", "التقييم", "اللجنة", "التنفيذ" };
}

<div class="bog-main">
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="mb-0 d-flex align-items-center gap-2">
                <span class="bog-page-icon" aria-hidden="true">
                    <span class="material-icons">folder_special</span>
                </span>
                طلباتي
            </h2>
            <a class="btn btn-primary" asp-controller="Ideas" asp-action="Create">
                <span class="material-icons align-middle" style="font-size:18px">add</span>
                تقديم فكرة جديدة
            </a>
        </div>

        <div class="card bog-section">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <strong>سجل الأفكار</strong>
                <span class="badge bg-secondary">@Model.Items.Count</span>
            </div>
            <div class="card-body p-0">
                @if (Model.Items.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>المرجع</th>
                                    <th>العنوان</th>
                                    <th>المجال</th>
                                    <th>الحالة</th>
                                    <th>المرحلة</th>
                                    <th>تاريخ التقديم</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var i in Model.Items)
                                {
                                    var stage = i.IsDraft ? 1 : IdeaProgress.StageFor(i.StatusCode);
                                    var stageLabel = i.IsDraft ? "مسودة" : IdeaProgress.LabelFor(stage);
                                    var percent = i.IsDraft ? 0 : IdeaProgress.PercentFor(stage);
                                    <tr>
                                        <td>
                                            @if (string.IsNullOrEmpty(i.Reference))
                                            {
                                                <span class="text-muted">مسودة</span>
                                            }
                                            else
                                            {
                                                <code>@i.Reference</code>
                                            }
                                        </td>
                                        <td>@i.Title</td>
                                        <td>—</td>
                                        <td>
                                            @if (i.IsDraft)
                                            {
                                                <span class="status-badge badge rounded-pill" style="background-color:#6c757d">مسودة</span>
                                            }
                                            else
                                            {
                                                @await Html.PartialAsync("_StatusBadge", i.CurrentStatus)
                                            }
                                        </td>
                                        <td>
                                            <div class="idea-progress" data-idea-progress
                                                 data-stage="@stage"
                                                 data-stage-label="@stageLabel"
                                                 data-total-stages="@IdeaProgress.TotalStages"
                                                 role="group"
                                                 aria-label="مرحلة الفكرة">
                                                <div class="idea-progress__track" aria-hidden="true">
                                                    @for (var s = 1; s <= IdeaProgress.TotalStages; s++)
                                                    {
                                                        var cls = s <= stage ? "idea-progress__step idea-progress__step--done" : "idea-progress__step";
                                                        <div class="@cls" data-step="@s" title="@stageLabels[s - 1]"></div>
                                                    }
                                                </div>
                                                <small class="text-muted d-block mt-1">@stageLabel · @(percent)%</small>
                                            </div>
                                        </td>
                                        <td><small>@(i.SubmittedAt?.ToString("yyyy-MM-dd") ?? i.CreatedAt.ToString("yyyy-MM-dd"))</small></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center text-muted p-5">
                        <span class="material-icons" style="font-size:48px;color:var(--text-muted)">lightbulb</span>
                        <p class="mb-1 mt-2">لم تقدّم أي فكرة بعد.</p>
                        <a class="btn btn-primary" asp-controller="Ideas" asp-action="Create">
                            ابدأ بتقديم فكرتك الأولى
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/progress-bar.js" asp-append-version="true"></script>
}
