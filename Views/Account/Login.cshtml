@model Ibtikar.ViewModels.LoginVm
@{
    ViewData["Title"] = "تسجيل الدخول";
    var error = ViewData["Error"] as string;
    var demoUsers = ViewData["DemoUsers"] as List<Ibtikar.Controllers.AccountController.DemoUser>;
}
<div class="bog-login-page">
    <div class="bog-login-card">
        <div class="bog-login-brand">
            <img src="~/img/BOG_Logo.svg" alt="أبتكر" class="bog-logo" />
        </div>
        <h1 class="bog-login-title">تسجيل الدخول</h1>
        <p class="bog-login-subtitle">بوابة الأفكار الابتكارية</p>

        @if (!string.IsNullOrEmpty(error))
        {
            <div class="alert bog-alert alert-danger" role="alert" data-toast data-toast-ttl="0">
                <span class="material-icons bog-alert-icon" aria-hidden="true">error</span>
                <span class="bog-alert-text">@error</span>
            </div>
        }

        <form method="post" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl" class="bog-login-form">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label asp-for="Username" class="form-label">اسم المستخدم</label>
                <input asp-for="Username" class="form-control" autocomplete="username" autofocus />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label">كلمة المرور</label>
                <input asp-for="Password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100">
                <span class="material-icons" aria-hidden="true">login</span>
                <span>دخول</span>
            </button>
        </form>

        <div class="bog-login-hint">
            <small class="text-muted">كلمة المرور الافتراضية للمستخدمين التجريبيين: Ibtikar@2026</small>
        </div>

        @if (demoUsers is { Count: > 0 })
        {
            <div class="bog-login-demo">
                <div class="bog-login-demo-title">
                    <span class="material-icons" aria-hidden="true">group</span>
                    <span>المستخدمون التجريبيون وصلاحياتهم</span>
                </div>
                <table class="table bog-login-demo-table">
                    <thead>
                        <tr>
                            <th>اسم المستخدم</th>
                            <th>الصلاحية</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in demoUsers)
                        {
                            <tr>
                                <td><code class="bog-login-demo-code">@u.Username</code></td>
                                <td>@u.RoleName</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
