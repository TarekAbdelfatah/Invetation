@model Ibtikar.ViewModels.CommitteeDecisionVm
@using Ibtikar.ViewModels
@{
    ViewData["Title"] = $"قرار اللجنة - {Model.Reference}";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var needsExtraConfirm = Model.CombinedAverage.HasValue && Model.CombinedAverage.Value < 40;
}

<div class="bog-main">
    <div class="container py-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
            <h2 class="mb-0 d-flex align-items-center gap-2">
                <span class="bog-page-icon" aria-hidden="true">
                    <span class="material-icons">fact_check</span>
                </span>
                قرار اللجنة
            </h2>
            <a class="btn btn-outline-secondary" asp-action="Referrals">
                <span class="material-icons align-middle" style="font-size:18px">arrow_forward</span>
                العودة للأفكار المحوّلة
            </a>
        </div>

        @if (TempData["AlertMessage"] is string ok)
        {
            <div class="alert alert-success">@ok</div>
        }
        @if (TempData["AlertError"] is string err)
        {
            <div class="alert alert-danger">@err</div>
        }

        <div class="card bog-section mb-3">
            <div class="card-body d-flex flex-wrap align-items-center gap-2">
                <code class="fs-6">@Model.Reference</code>
                <h1 class="h5 mb-0 ms-2">@Model.Title</h1>
            </div>
        </div>

        <div class="card bog-section mb-3">
            <div class="card-body">
                <div class="text-center mb-3">
                    <div class="text-muted small">النسبة المجمعة (الإدارة المختصة + اللجنة)</div>
                    <div class="display-4 fw-bold @(Model.CombinedAverage >= 80 ? "text-success" : Model.CombinedAverage >= 40 ? "text-warning" : "text-danger")">
                        @(Model.CombinedAverage?.ToString() ?? "—")%
                    </div>
                </div>

                @if (needsExtraConfirm)
                {
                    <div class="alert alert-danger d-flex align-items-start gap-2">
                        <span class="material-icons">warning</span>
                        <div>
                            <strong>تنبيه:</strong> النسبة المجمعة أقل من 40%. قبول الفكرة يتطلب تأكيداً إضافياً من رئيس اللجنة.
                        </div>
                    </div>
                }
                else if (Model.CombinedAverage.HasValue && Model.CombinedAverage.Value >= 80)
                {
                    <div class="alert alert-success d-flex align-items-start gap-2">
                        <span class="material-icons">check_circle</span>
                        <div>النسبة المجمعة تسمح بقبول الفكرة ونقلها إلى مرحلة التنفيذ.</div>
                    </div>
                }
            </div>
        </div>

        @if (Model.CanAccept)
        {
            <form asp-action="Accept" method="post" class="card bog-section">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ideaId" value="@Model.IdeaId" />
                @if (needsExtraConfirm)
                {
                    <div class="card-body">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="extraConfirmed" name="extraConfirmed" value="true" />
                            <label class="form-check-label" for="extraConfirmed">
                                أؤكد قبول الفكرة رغم أن النسبة المجمعة أقل من 40%.
                            </label>
                        </div>
                    </div>
                    <div class="card-footer bg-white d-flex gap-2">
                        <button type="submit" class="btn btn-danger" id="acceptBtn" disabled>
                            قبول مع تأكيد إضافي
                        </button>
                        <a asp-action="Referrals" class="btn btn-outline-secondary">إلغاء</a>
                    </div>
                }
                else
                {
                    <div class="card-footer bg-white d-flex gap-2">
                        <button type="submit" class="btn btn-success">
                            قبول الفكرة
                        </button>
                        <a asp-action="Referrals" class="btn btn-outline-secondary">إلغاء</a>
                    </div>
                }
            </form>
        }
        else
        {
            <div class="alert alert-light border text-center py-4">
                <div class="text-muted">الفكرة ليست في حالة (محوّلة للجنة) ويمكن اتخاذ قرار بشأنها.</div>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
    (function () {
        const cb = document.getElementById('extraConfirmed');
        const btn = document.getElementById('acceptBtn');
        if (!cb || !btn) return;
        cb.addEventListener('change', function () {
            btn.disabled = !cb.checked;
        });
    })();
</script>
}
