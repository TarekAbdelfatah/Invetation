@model IReadOnlyList<Ibtikar.ViewModels.IdeaListItemVm>
@{
    ViewData["Title"] = "سجل الأفكار";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="bog-main">
    <div class="container py-4">
        <div class="bog-page-header">
            <h1>
                <span class="bog-page-icon" aria-hidden="true">
                    <span class="material-icons">lightbulb</span>
                </span>
                سجل الأفكار الابتكارية
            </h1>
            <span class="bog-page-role">
                <span class="material-icons" aria-hidden="true">numbers</span>
                عدد الأفكار: @Model.Count
            </span>
        </div>

        @if (!Model.Any())
        {
            <div class="card bog-section">
                <div class="card-body text-center text-muted p-5">
                    <span class="material-icons" style="font-size:48px;color:var(--text-muted)">lightbulb</span>
                    <p class="mb-1 mt-2">لا توجد أفكار مسجلة بعد.</p>
                    <a class="btn btn-primary mt-3" asp-controller="Ideas" asp-action="Create">
                        <span class="material-icons align-middle" style="font-size:18px">add</span>
                        ابدأ بتقديم فكرتك الأولى
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="card bog-section">
                <div class="card-header bg-white d-flex align-items-center gap-2">
                    <span class="material-icons text-primary">inventory_2</span>
                    <strong>جميع الأفكار</strong>
                </div>
                <div class="card-body p-0">
                    <div class="bog-mobile-cards d-md-none">
                        @foreach (var idea in Model)
                        {
                            <a class="bog-idea-card" asp-action="Details" asp-route-id="@idea.Id">
                                <div class="bog-idea-card__head">
                                    <span class="bog-idea-card__ref"><code>@idea.ReferenceNumber</code></span>
                                    @if (!string.IsNullOrEmpty(idea.StatusName))
                                    {
                                        <span class="bog-idea-card__status" style="--chip-bg:@idea.StatusColor">
                                            <span class="bog-idea-card__status-dot" style="background-color:@idea.StatusColor"></span>
                                            @idea.StatusName
                                        </span>
                                    }
                                </div>
                                <h3 class="bog-idea-card__title">@idea.Title</h3>
                                <div class="bog-idea-card__foot">
                                    <small class="bog-idea-card__date">
                                        <span class="material-icons" style="font-size:14px">event</span>
                                        @(idea.SubmittedAt?.ToString("yyyy-MM-dd") ?? idea.CreatedAt.ToString("yyyy-MM-dd"))
                                    </small>
                                    <span class="bog-idea-card__chevron">
                                        التفاصيل
                                        <span class="material-icons" style="font-size:18px">chevron_left</span>
                                    </span>
                                </div>
                            </a>
                        }
                    </div>

                    <div class="table-responsive d-none d-md-block">
                        <table class="bog-card-list">
                            <thead>
                                <tr>
                                    <th>المرجع</th>
                                    <th>العنوان</th>
                                    <th class="d-none d-lg-table-cell">المجال</th>
                                    <th>الحالة</th>
                                    <th class="d-none d-md-table-cell">الجهة</th>
                                    <th class="d-none d-md-table-cell">تاريخ التقديم</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var idea in Model)
                                {
                                    <tr>
                                        <td data-label="المرجع"><code>@idea.ReferenceNumber</code></td>
                                        <td data-label="العنوان">@idea.Title</td>
                                        <td class="d-none d-lg-table-cell" data-label="المجال">@idea.DomainName</td>
                                        <td data-label="الحالة">
                                            @if (!string.IsNullOrEmpty(idea.StatusName))
                                            {
                                                <span class="status-badge badge rounded-pill" style="background-color:@idea.StatusColor">
                                                    @idea.StatusName
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td class="d-none d-md-table-cell" data-label="الجهة">@(idea.DepartmentName ?? "—")</td>
                                        <td class="d-none d-md-table-cell" data-label="تاريخ التقديم">@(idea.SubmittedAt?.ToString("yyyy-MM-dd") ?? idea.CreatedAt.ToString("yyyy-MM-dd"))</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>
</div>