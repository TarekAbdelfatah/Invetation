@model IReadOnlyList<Ibtikar.Models.InnovationIdea>
@{
    ViewData["Title"] = "سجل الأفكار";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0 d-flex align-items-center gap-2">
            <span class="bog-page-icon" aria-hidden="true">
                <span class="material-icons">lightbulb</span>
            </span>
            <span>سجل الأفكار الابتكارية</span>
        </h2>
        <span class="text-muted">عدد الأفكار: @Model.Count</span>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info" role="alert">
            لا توجد أفكار مسجلة بعد. ابدأ بتقديم فكرة جديدة من خلال نموذج التقديم.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>المرجع</th>
                        <th>العنوان</th>
                        <th>المجال</th>
                        <th>الحالة</th>
                        <th>الجهة</th>
                        <th>تاريخ التقديم</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var idea in Model)
                    {
                        <tr>
                            <td><code>@idea.ReferenceNumber</code></td>
                            <td>@idea.Title</td>
                            <td>@idea.InnovationDomain?.Name</td>
                            <td>
                                @if (idea.CurrentStatus is not null)
                                {
                                    <partial name="_StatusBadge" model="idea.CurrentStatus" />
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>@(idea.ApplicantDepartment?.Name ?? "—")</td>
                            <td>@(idea.SubmittedAt?.ToString("yyyy-MM-dd") ?? idea.CreatedAt.ToString("yyyy-MM-dd"))</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>