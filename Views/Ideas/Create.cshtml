@model Ibtikar.ViewModels.IdeaCreateViewModel
@{
    ViewData["Title"] = "تقديم فكرة جديدة";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card bog-section">
                <div class="card-body p-4 p-md-5">
                    <div class="mb-4 text-center">
                        <span class="material-icons" style="font-size:60px;color:var(--gold-500)">lightbulb</span>
                        <h1 class="mt-2 mb-1">نموذج تقديم الأفكار</h1>
                        <p class="text-muted mb-0">املأ البيانات التالية وقدّم فكرتك</p>
                    </div>

                    <form asp-action="Create" method="post" enctype="multipart/form-data" id="idea-form">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <input type="hidden" asp-for="CurrentDraftId" />

                        @if (Model.IsInternalApplicant)
                        {
                            <div class="alert alert-light border mb-4">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">@Html.DisplayNameFor(m => m.ApplicantFullName)</label>
                                        <input class="form-control" value="@Model.ApplicantFullName" readonly disabled />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">@Html.DisplayNameFor(m => m.ApplicantDepartmentName)</label>
                                        <input class="form-control" value="@(Model.ApplicantDepartmentName ?? "—")" readonly disabled />
                                    </div>
                                </div>
                                <small class="text-muted d-block mt-2">
                                    <i class="bi bi-info-circle"></i>
                                    تم تعبئة الاسم والإدارة تلقائياً من حسابك ولا يمكن تعديلهما.
                                </small>
                            </div>
                        }

                        <div class="mb-4">
                            <label asp-for="Title" class="form-label fw-semibold"></label>
                            <span class="text-danger">*</span>
                            <input asp-for="Title" class="form-control" maxlength="200" data-required-on-submit="true" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Description" class="form-label fw-semibold"></label>
                            <span class="text-danger">*</span>
                            <textarea asp-for="Description" class="form-control" rows="4"
                                      data-char-limit="@Ibtikar.ViewModels.IdeaCreateViewModel.DescriptionMax"
                                      data-required-on-submit="true"></textarea>
                            <small class="form-text text-muted d-block" data-char-counter="Description"></small>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ProblemStatement" class="form-label fw-semibold"></label>
                            <textarea asp-for="ProblemStatement" class="form-control" rows="4"
                                      data-char-limit="@Ibtikar.ViewModels.IdeaCreateViewModel.ProblemMax"
                                      data-required-on-submit="true"></textarea>
                            <small class="form-text text-muted d-block" data-char-counter="ProblemStatement"></small>
                            <span asp-validation-for="ProblemStatement" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ProposedSolution" class="form-label fw-semibold"></label>
                            <textarea asp-for="ProposedSolution" class="form-control" rows="3"
                                      data-char-limit="@Ibtikar.ViewModels.IdeaCreateViewModel.SolutionMax"
                                      data-required-on-submit="true"></textarea>
                            <small class="form-text text-muted d-block" data-char-counter="ProposedSolution"></small>
                            <span asp-validation-for="ProposedSolution" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ExpectedBenefits" class="form-label fw-semibold"></label>
                            <textarea asp-for="ExpectedBenefits" class="form-control" rows="3"
                                      data-char-limit="@Ibtikar.ViewModels.IdeaCreateViewModel.BenefitsMax"
                                      data-required-on-submit="true"></textarea>
                            <small class="form-text text-muted d-block" data-char-counter="ExpectedBenefits"></small>
                            <span asp-validation-for="ExpectedBenefits" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="RequiredResources" class="form-label fw-semibold"></label>
                            <textarea asp-for="RequiredResources" class="form-control" rows="3"
                                      placeholder="مثل: فريق تطوير متخصص، خوادم إضافية، ميزانية تشغيل..."
                                      data-char-limit="@Ibtikar.ViewModels.IdeaCreateViewModel.RequiredResourcesMax"></textarea>
                            <small class="form-text text-muted d-block" data-char-counter="RequiredResources"></small>
                            <span asp-validation-for="RequiredResources" class="text-danger small"></span>
                        </div>

                        <hr />

                        <div class="mb-4">
                            <label asp-for="InnovationDomainId" class="form-label fw-semibold"></label>
                            <span class="text-danger">*</span>
                            <select asp-for="InnovationDomainId" asp-items="@(ViewBag.InnovationDomains as IEnumerable<SelectListItem>)"
                                    class="form-select" data-required-on-submit="true">
                                <option value="">-- اختر مجال الابتكار --</option>
                            </select>
                            <span asp-validation-for="InnovationDomainId" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ExpectedImpactId" class="form-label fw-semibold"></label>
                            <select asp-for="ExpectedImpactId" asp-items="@(ViewBag.ExpectedImpacts as IEnumerable<SelectListItem>)"
                                    class="form-select" data-other="ExpectedImpactOther" data-required-on-submit="true">
                                <option value="">-- اختر الأثر المتوقع --</option>
                            </select>
                            <span asp-validation-for="ExpectedImpactId" class="text-danger small"></span>
                        </div>

                        <div class="mb-4 d-none" data-other-field="ExpectedImpactOther">
                            <label asp-for="ExpectedImpactOther" class="form-label fw-semibold"></label>
                            <input asp-for="ExpectedImpactOther" class="form-control" maxlength="200" />
                            <span asp-validation-for="ExpectedImpactOther" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="TargetAudienceId" class="form-label fw-semibold"></label>
                            <select asp-for="TargetAudienceId" asp-items="@(ViewBag.TargetAudiences as IEnumerable<SelectListItem>)"
                                    class="form-select" data-other="TargetAudienceOther" data-required-on-submit="true">
                                <option value="">-- اختر الفئة المستهدفة --</option>
                            </select>
                            <span asp-validation-for="TargetAudienceId" class="text-danger small"></span>
                        </div>

                        <div class="mb-4 d-none" data-other-field="TargetAudienceOther">
                            <label asp-for="TargetAudienceOther" class="form-label fw-semibold"></label>
                            <input asp-for="TargetAudienceOther" class="form-control" maxlength="200" />
                            <span asp-validation-for="TargetAudienceOther" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <div class="form-check form-switch">
                                <input asp-for="UsesEmergingTech" class="form-check-input" type="checkbox" id="uses-emerging-tech" />
                                <label asp-for="UsesEmergingTech" class="form-check-label"></label>
                            </div>
                        </div>

                        <div class="mb-4 d-none" data-emerging-tech="true">
                            <label class="form-label fw-semibold">التقنيات الناشئة</label>
                            <div class="row g-3" data-tech-list="true">
                                @foreach (var tech in (ViewBag.Technologies as IEnumerable<SelectListItem>) ?? Enumerable.Empty<SelectListItem>())
                                {
                                    var techId = tech.Value;
                                    <div class="col-md-6">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox"
                                                   name="TechnologyIds" value="@techId"
                                                   id="tech-@techId"
                                                   @(Model.TechnologyIds.Contains(Guid.Parse(techId)) ? "checked" : "") />
                                            <label class="form-check-label" for="tech-@techId">@tech.Text</label>
                                        </div>
                                    </div>
                                }
                            </div>

                            <div class="mb-4 mt-3 d-none" data-other-field="TechnologyOther">
                                <label asp-for="TechnologyOther" class="form-label fw-semibold"></label>
                                <input asp-for="TechnologyOther" class="form-control" maxlength="200" />
                                <span asp-validation-for="TechnologyOther" class="text-danger small"></span>
                            </div>
                        </div>

                        <hr />

                        <div class="mb-4">
                            <label class="form-label fw-semibold">
                                <span class="material-icons align-middle" style="font-size:18px">attach_file</span>
                                المرفقات (اختيارية في المسودة، إلزامية عند الإرسال)
                            </label>
                            <small class="form-text text-muted d-block mb-2">
                                PDF فقط، حتى ملفين، 5 ميجا لكل ملف.
                            </small>
                            @await Component.InvokeAsync("IdeaAttachmentUploader", new { ideaId = Model.CurrentDraftId })
                        </div>

                        <hr />

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <button type="submit" name="action" value="SaveDraft" class="btn btn-outline-secondary">
                                <span class="material-icons align-middle" style="font-size:18px">save</span>
                                حفظ المسودة
                            </button>
                            <button type="submit" name="action" value="Submit" class="btn btn-primary">
                                <span class="material-icons align-middle" style="font-size:18px">send</span>
                                إرسال الفكرة
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/idea-form.js" asp-append-version="true"></script>
    <script src="~/js/idea-attachments.js" asp-append-version="true"></script>
}
