@model Ibtikar.ViewModels.CommitteesIndexVm
@using Ibtikar.ViewModels
@{
    ViewData["Title"] = "لجان الابتكار";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["SuppressGlobalAlert"] = true;
}

<div class="bog-main">
    <div class="container py-4">
        <div class="bog-page-header">
            <h1>
                <span class="bog-page-icon" aria-hidden="true">
                    <span class="material-icons">groups</span>
                </span>
                لجان الابتكار
            </h1>
            <span class="bog-page-role">
                <span class="material-icons" aria-hidden="true">admin_panel_settings</span>
                إدارة النظام
            </span>
        </div>

        @if (TempData["AlertMessage"] is string ok)
        {
            ViewData["Type"] = "success";
            ViewData["Dismissible"] = true;
            ViewData["Ttl"] = 5000;
            @await Html.PartialAsync("_Alert", ok)
        }
        @if (TempData["AlertError"] is string err)
        {
            ViewData["Type"] = "danger";
            ViewData["Dismissible"] = true;
            ViewData["Ttl"] = 0;
            @await Html.PartialAsync("_Alert", err)
        }
        @if (ViewBag.DatabaseError is string dbErr)
        {
            ViewData["Type"] = "danger";
            ViewData["Dismissible"] = true;
            ViewData["Ttl"] = 0;
            @await Html.PartialAsync("_Alert", "تعذر الاتصال بقاعدة البيانات: " + dbErr)
        }

        <div class="d-flex justify-content-end mb-3">
            <a class="btn btn-primary" asp-action="Create">
                <span class="material-icons" aria-hidden="true">add</span>
                إنشاء لجنة
            </a>
        </div>

        @if (Model.Committees.Count == 0)
        {
            <div class="alert alert-light border text-center py-5">
                <span class="material-icons text-muted d-block mb-2" style="font-size:3rem">groups</span>
                <div class="text-muted">لم يتم إنشاء أي لجنة بعد.</div>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>الاسم</th>
                            <th>رئيس اللجنة</th>
                            <th>عدد الأعضاء</th>
                            <th>الحالة</th>
                            <th>تاريخ الإنشاء</th>
                            <th>إجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model.Committees)
                        {
                            <tr>
                                <td class="fw-semibold">@c.Name</td>
                                <td>@c.HeadUserName</td>
                                <td>@c.MemberCount</td>
                                <td>
                                    @if (c.IsActive)
                                    {
                                        <span class="badge bg-success">نشطة</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">غير مفعّلة</span>
                                    }
                                </td>
                                <td>@c.CreatedAt.ToString("yyyy-MM-dd")</td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary"
                                       title="عرض التفاصيل">
                                        <span class="material-icons" style="font-size:18px">visibility</span>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-warning"
                                       title="تعديل">
                                        <span class="material-icons" style="font-size:18px">edit</span>
                                    </a>
                                    @if (!c.IsActive)
                                    {
                                        <form asp-action="Activate" asp-route-id="@c.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-success"
                                                    data-confirm-trigger data-confirm-message="هل تريد تفعيل هذه اللجنة وإشعار جميع أعضائها؟">
                                                تفعيل
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
