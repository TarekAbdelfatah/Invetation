@model Ibtikar.ViewModels.CommitteeDetailVm
@{
    ViewData["Title"] = $"تفاصيل اللجنة — {Model.Name}";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["SuppressGlobalAlert"] = true;
}

<div class="bog-main">
    <div class="container py-4">
        <div class="bog-page-header">
            <h1>
                <span class="bog-page-icon" aria-hidden="true">
                    <span class="material-icons">info</span>
                </span>
                تفاصيل اللجنة
            </h1>
            <a class="btn btn-outline-secondary" asp-action="Index">
                <span class="material-icons align-middle" style="font-size:18px">arrow_forward</span>
                العودة للقائمة
            </a>
        </div>

        @if (TempData["AlertMessage"] is string ok)
        {
            ViewData["Type"] = "success";
            ViewData["Dismissible"] = true;
            ViewData["Ttl"] = 5000;
            @await Html.PartialAsync("_Alert", ok)
        }
        @if (TempData["AlertError"] is string err)
        {
            ViewData["Type"] = "danger";
            ViewData["Dismissible"] = true;
            ViewData["Ttl"] = 0;
            @await Html.PartialAsync("_Alert", err)
        }

        <div class="card mb-3">
            <div class="card-header bg-white d-flex justify-content-between align-items-center flex-wrap gap-2">
                <strong class="fs-5">@Model.Name</strong>
                @if (Model.IsActive)
                {
                    <span class="badge bg-success">نشطة</span>
                }
                else
                {
                    <span class="badge bg-secondary">غير مفعّلة</span>
                }
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-3">الاسم</dt>
                    <dd class="col-sm-9">@Model.Name</dd>

                    <dt class="col-sm-3">الوصف</dt>
                    <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Description) ? "—" : Model.Description)</dd>

                    <dt class="col-sm-3">الحالة</dt>
                    <dd class="col-sm-9">
                        @if (Model.IsActive)
                        {
                            <span class="text-success">نشطة</span>
                            if (Model.ActivatedAt.HasValue)
                            {
                                <span class="text-muted me-2">بتاريخ @Model.ActivatedAt.Value.ToString("yyyy-MM-dd HH:mm")</span>
                            }
                        }
                        else
                        {
                            <span class="text-secondary">غير مفعّلة</span>
                        }
                    </dd>

                    <dt class="col-sm-3">تاريخ الإنشاء</dt>
                    <dd class="col-sm-9">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>

                    <dt class="col-sm-3">رئيس اللجنة</dt>
                    <dd class="col-sm-9">
                        <strong>@Model.HeadUserName</strong>
                        <span class="text-muted">(@Model.HeadUsername)</span>
                    </dd>

                    <dt class="col-sm-3">عدد الأعضاء</dt>
                    <dd class="col-sm-9">@Model.Members.Count</dd>
                </dl>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header bg-white">
                <strong>
                    <span class="material-icons align-middle" style="font-size:20px">group</span>
                    أعضاء اللجنة
                </strong>
            </div>
            <div class="card-body p-0">
                @if (Model.Members.Count == 0)
                {
                    <div class="text-center text-muted py-4">لا يوجد أعضاء.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:40px">#</th>
                                    <th>الاسم</th>
                                    <th>اسم المستخدم</th>
                                    <th style="width:100px">الدور</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ var idx = 0; }
                                @foreach (var m in Model.Members)
                                {
                                    idx++;
                                    <tr class="@(m.IsHead ? "table-active" : "")">
                                        <td class="text-muted">@idx</td>
                                        <td class="fw-semibold">
                                            @m.FullName
                                            @if (m.IsHead)
                                            {
                                                <span class="material-icons align-middle text-primary" style="font-size:16px" title="رئيس اللجنة">star</span>
                                            }
                                        </td>
                                        <td><code>@m.Username</code></td>
                                        <td>
                                            @if (m.IsHead)
                                            {
                                                <span class="badge bg-primary">رئيس</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-dark">عضو</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">
                <span class="material-icons align-middle" style="font-size:18px">edit</span>
                تعديل اللجنة
            </a>
            @if (!Model.IsActive)
            {
                <form asp-action="Activate" asp-route-id="@Model.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-primary"
                            data-confirm-trigger data-confirm-message="هل تريد تفعيل اللجنة وإشعار جميع أعضائها؟">
                        <span class="material-icons align-middle" style="font-size:18px">check_circle</span>
                        تفعيل اللجنة
                    </button>
                </form>
            }
            <a asp-action="Index" class="btn btn-outline-secondary">العودة للقائمة</a>
        </div>
    </div>
</div>
