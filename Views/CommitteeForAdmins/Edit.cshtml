@model Ibtikar.ViewModels.CommitteesEditVm
@using Ibtikar.ViewModels
@{
    ViewData["Title"] = "تعديل اللجنة — " + Model.Name;
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["SuppressGlobalAlert"] = true;
}

<div class="bog-main">
    <div class="container py-4">
        <div class="bog-page-header">
            <h1>
                <span class="bog-page-icon" aria-hidden="true">
                    <span class="material-icons">edit</span>
                </span>
                تعديل اللجنة
            </h1>
            <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id">
                <span class="material-icons align-middle" style="font-size:18px">arrow_forward</span>
                العودة للتفاصيل
            </a>
        </div>

        @if (TempData["AlertMessage"] is string ok)
        {
            ViewData["Type"] = "success";
            ViewData["Dismissible"] = true;
            ViewData["Ttl"] = 5000;
            @await Html.PartialAsync("_Alert", ok)
        }
        @if (TempData["AlertError"] is string err)
        {
            ViewData["Type"] = "danger";
            ViewData["Dismissible"] = true;
            ViewData["Ttl"] = 0;
            @await Html.PartialAsync("_Alert", err)
        }

        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" id="committeeForm" data-loading="false">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div class="card mb-3">
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label" asp-for="Name">اسم اللجنة <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" asp-for="Description">الوصف</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" asp-for="HeadUserId">رئيس اللجنة <span class="text-danger">*</span></label>
                        <input type="text" id="headSearch" class="form-control mb-2" placeholder="بحث في أسماء الموظفين..." autocomplete="off" />
                        <select asp-for="HeadUserId" class="form-select" id="HeadUserId">
                            <option value="">— اختر رئيس اللجنة —</option>
                            @foreach (var h in Model.HeadCandidates)
                            {
                                <option value="@h.UserId" data-search="@(h.FullName + " " + h.Username)">@h.FullName (@h.Username)</option>
                            }
                        </select>
                        <span asp-validation-for="HeadUserId" class="text-danger"></span>
                        <div class="form-text">يجب اختيار رئيس واحد فقط، ويُضاف تلقائياً ضمن أعضاء اللجنة.</div>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label class="form-label mb-0">الأعضاء <span class="text-danger">*</span></label>
                            <span id="memberCount" class="badge bg-primary">0 مختار</span>
                        </div>
                        <input type="text" id="memberSearch" class="form-control mb-2" placeholder="بحث في أسماء الموظفين..." autocomplete="off" />
                        <div class="member-list-container" id="memberList">
                            @foreach (var m in Model.MemberCandidates)
                            {
                                var isChecked = Model.MemberUserIds.Contains(m.UserId);
                                <div class="form-check member-item">
                                    <input class="form-check-input member-check"
                                           type="checkbox"
                                           name="MemberUserIds"
                                           id="member_@m.UserId"
                                           value="@m.UserId"
                                           @(isChecked ? "checked" : "") />
                                    <label class="form-check-label" for="member_@m.UserId">
                                        @m.FullName <span class="text-muted">(@m.Username)</span>
                                    </label>
                                </div>
                            }
                        </div>
                        <span asp-validation-for="MemberUserIds" class="text-danger"></span>
                        <div class="form-text">يجب إضافة عضو واحد على الأقل من غير رئيس اللجنة.</div>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">حفظ التعديلات</button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">إلغاء</a>
            </div>
        </form>
    </div>
</div>

<div id="committeeValidationModal" class="bog-modal" hidden role="dialog" aria-modal="true"
     aria-labelledby="committeeValidationTitle" aria-describedby="committeeValidationMessage">
    <div class="bog-modal-backdrop" data-close-committee-validation></div>
    <div class="bog-modal-dialog bog-modal-dialog-centered" role="document">
        <div class="bog-modal-content">
            <h5 id="committeeValidationTitle" class="bog-modal-title">
                <span class="material-icons align-middle text-warning" aria-hidden="true">warning</span>
                تنبيه
            </h5>
            <p id="committeeValidationMessage" class="bog-modal-body text-secondary"></p>
            <div class="bog-modal-actions">
                <button type="button" class="btn btn-primary" data-close-committee-validation>حسناً</button>
            </div>
        </div>
    </div>
</div>

<style>
    .member-list-container {
        max-height: 320px;
        overflow-y: auto;
        border: 1px solid var(--bs-border-color);
        border-radius: .375rem;
        padding: .5rem;
    }
    .member-list-container .form-check {
        padding: .4rem .5rem;
        margin-bottom: 0;
        border-radius: .25rem;
        transition: background .15s;
    }
    .member-list-container .form-check:hover {
        background: var(--bs-primary-bg-subtle, rgba(13,110,253,.06));
    }
    .member-list-container .form-check-label {
        width: 100%;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        var form = document.getElementById('committeeForm');
        var head = document.getElementById('HeadUserId');
        var headSearch = document.getElementById('headSearch');
        var memberSearch = document.getElementById('memberSearch');
        var memberChecks = Array.prototype.slice.call(document.querySelectorAll('.member-check'));
        var memberCountEl = document.getElementById('memberCount');
        var modal = document.getElementById('committeeValidationModal');
        var messageEl = modal ? modal.querySelector('#committeeValidationMessage') : null;

        function showValidation(message) {
            if (!modal || !messageEl) { alert(message); return; }
            messageEl.textContent = message;
            modal.hidden = false;
            modal.setAttribute('data-open', 'true');
        }

        function closeValidation() {
            if (!modal) return;
            modal.hidden = true;
            modal.removeAttribute('data-open');
        }

        function syncHeadExclusion() {
            var headValue = head.value;
            memberChecks.forEach(function (c) {
                var isHeadOption = c.value === headValue;
                var wrap = c.closest('.form-check');
                if (headValue && isHeadOption) {
                    c.checked = false;
                    c.disabled = true;
                    if (wrap) wrap.classList.add('text-muted');
                } else {
                    c.disabled = false;
                    if (wrap) wrap.classList.remove('text-muted');
                }
            });
            updateMemberCount();
        }

        function updateMemberCount() {
            var count = memberChecks.filter(function (c) { return c.checked && !c.disabled; }).length;
            if (memberCountEl) memberCountEl.textContent = count + ' مختار';
        }

        head.addEventListener('change', syncHeadExclusion);
        syncHeadExclusion();

        memberChecks.forEach(function (c) {
            c.addEventListener('change', updateMemberCount);
        });
        updateMemberCount();

        if (headSearch) {
            headSearch.addEventListener('input', function () {
                var q = headSearch.value.trim().toLowerCase();
                var options = head.querySelectorAll('option[value]');
                options.forEach(function (opt) {
                    if (!opt.value) { opt.style.display = ''; return; }
                    var text = (opt.getAttribute('data-search') || opt.textContent).toLowerCase();
                    opt.style.display = text.indexOf(q) === -1 ? 'none' : '';
                });
                if (head.value && head.options[head.selectedIndex].style.display === 'none') {
                    head.value = '';
                }
            });
        }

        if (memberSearch) {
            memberSearch.addEventListener('input', function () {
                var q = memberSearch.value.trim().toLowerCase();
                memberChecks.forEach(function (c) {
                    var wrap = c.closest('.form-check');
                    if (!wrap) return;
                    var label = wrap.querySelector('.form-check-label');
                    var text = (label ? label.textContent : '').toLowerCase();
                    wrap.style.display = text.indexOf(q) === -1 ? 'none' : '';
                });
            });
        }

        if (modal) {
            modal.querySelectorAll('[data-close-committee-validation]').forEach(function (el) {
                el.addEventListener('click', closeValidation);
            });
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && !modal.hidden) closeValidation();
            });
        }

        form.addEventListener('submit', function (e) {
            var checked = memberChecks.filter(function (c) { return c.checked; });
            var headValue = head.value;
            var message = null;
            if (!headValue) {
                message = 'يرجى اختيار رئيس اللجنة.';
            } else if (checked.length < 1) {
                message = 'يرجى إضافة عضو واحد على الأقل من غير رئيس اللجنة.';
            } else if (checked.some(function (c) { return c.value === headValue; })) {
                message = 'لا يمكن اختيار رئيس اللجنة ضمن الأعضاء؛ يُضاف تلقائياً كعضو.';
            }
            if (message) {
                e.preventDefault();
                e.stopPropagation();
                showValidation(message);
                return;
            }
            if (window.BogLoading && BogLoading.show) {
                BogLoading.show('جارٍ حفظ التعديلات...');
            }
        });
    });
</script>
