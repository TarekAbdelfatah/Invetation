@{
    ViewData["Title"] = "ابتكار — بوابة الأفكار الابتكارية";
    var isAuth = User.Identity?.IsAuthenticated == true;
}

<div class="bog-home">
    <section class="bog-home-hero">
        <div class="container">
            <div class="row align-items-center gy-5">
                <div class="col-lg-7 text-white">
                    <span class="badge rounded-pill px-3 py-2 mb-3" style="background: rgba(255,255,255,0.18); backdrop-filter: blur(6px);">
                        <span class="material-icons align-middle" style="font-size:16px">workspace_premium</span>
                        منصة رسمية لإدارة الأفكار
                    </span>
                    <h1 class="display-5 fw-bold mb-3" style="line-height: 1.25;">
                        حوّل أفكارك إلى <span style="color: var(--gold-300);">قرارات</span> تنفذ داخل الجهة.
                    </h1>
                    <p class="lead opacity-90 mb-4" style="max-width: 620px;">
                        ابتكار هي البوابة الموحدة لتقديم الأفكار ومتابعتها عبر كل المراحل: من المسودة إلى الاعتماد والتنفيذ، مع إشعارات فورية ودور واضح لكل صاحب دور.
                    </p>
                    <div class="d-flex flex-wrap gap-3">
                        @if (isAuth)
                        {
                            <a class="btn btn-light btn-lg fw-semibold px-4" asp-controller="Ideas" asp-action="Create">
                                <span class="material-icons align-middle" style="font-size:20px">add_circle</span>
                                قدّم فكرة جديدة
                            </a>
                            <a class="btn btn-outline-light btn-lg px-4" asp-controller="MyRequests" asp-action="Index">
                                <span class="material-icons align-middle" style="font-size:20px">folder</span>
                                طلباتي
                            </a>
                        }
                        else
                        {
                            <a class="btn btn-light btn-lg fw-semibold px-4" asp-controller="Account" asp-action="Login">
                                <span class="material-icons align-middle" style="font-size:20px">login</span>
                                تسجيل الدخول
                            </a>
                            <a class="btn btn-outline-light btn-lg px-4" href="#how-it-works">
                                كيف تعمل المنصة؟
                            </a>
                        }
                    </div>
                </div>
                <div class="col-lg-5 d-none d-lg-block">
                    <div class="bog-home-hero-card card border-0 shadow-lg">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center gap-2 text-primary fw-bold mb-3">
                                <span class="material-icons">timeline</span>
                                دورة حياة الفكرة
                            </div>
                            <ul class="list-unstyled m-0 bog-home-steps">
                                <li><span class="bog-home-step">١</span><div><strong>التقديم</strong><small>أفكار داخلية وخارجية ترفع عبر نموذج موحد.</small></div></li>
                                <li><span class="bog-home-step">٢</span><div><strong>التدقيق</strong><small>موظف التدقيق يفتح الملف ويستكمل البيانات أو يحوله.</small></div></li>
                                <li><span class="bog-home-step">٣</span><div><strong>التقييم</strong><small>اللجنة تقيّم الأثر والقيمة.</small></div></li>
                                <li><span class="bog-home-step">٤</span><div><strong>الاعتماد والتنفيذ</strong><small>الفكرة المعتمدة تتحول إلى مشروع منفذ داخل الإدارة المختصة.</small></div></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="bog-home-features py-5" id="how-it-works">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="fw-bold">لماذا ابتكار؟</h2>
                <p class="text-muted mb-0">أربع قيم تجعلك تستخدمها كل يوم.</p>
            </div>
            <div class="row g-4">
                <div class="col-md-6 col-lg-3">
                    <div class="card bog-home-feature h-100">
                        <div class="card-body">
                            <span class="bog-home-feature-icon bg-success-subtle text-success">
                                <span class="material-icons">bolt</span>
                            </span>
                            <h5 class="fw-bold mt-3">سرعة المتابعة</h5>
                            <p class="text-muted mb-0">صندوق تدقيق فوري مع تنبيه باللون الأحمر لأي فكرة تأخرت عن ٤٨ ساعة.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="card bog-home-feature h-100">
                        <div class="card-body">
                            <span class="bog-home-feature-icon bg-info-subtle text-info">
                                <span class="material-icons">admin_panel_settings</span>
                            </span>
                            <h5 class="fw-bold mt-3">صلاحيات واضحة</h5>
                            <p class="text-muted mb-0">كل دور يرى فقط ما يخصه ولا يصل إلى بيانات غيره.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="card bog-home-feature h-100">
                        <div class="card-body">
                            <span class="bog-home-feature-icon bg-warning-subtle text-warning">
                                <span class="material-icons">devices</span>
                            </span>
                            <h5 class="fw-bold mt-3">متجاوب مع الجوال</h5>
                            <p class="text-muted mb-0">تصميم يعمل على الجوال للمستخدم الخارجي وعلى الشاشة الكبيرة للمكتب.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="card bog-home-feature h-100">
                        <div class="card-body">
                            <span class="bog-home-feature-icon bg-primary-subtle text-primary">
                                <span class="material-icons">history_edu</span>
                            </span>
                            <h5 class="fw-bold mt-3">سجل كامل</h5>
                            <p class="text-muted mb-0">كل قرار وكل انتقال حالة موثّق وموقّت.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<style>
.bog-home-hero {
  background: var(--grad-brand-90);
  padding: 80px 0 96px;
  position: relative;
  overflow: hidden;
}
.bog-home-hero::before {
  content: "";
  position: absolute;
  inset: 0;
  background:
    radial-gradient(800px 400px at 80% -10%, rgba(255,255,255,0.12), transparent 60%),
    radial-gradient(500px 300px at 10% 110%, rgba(247,213,77,0.10), transparent 60%);
  pointer-events: none;
}
.bog-home-hero .container { position: relative; }
.bog-home-hero-card {
  border-radius: var(--radius-3xl, 20px);
  transform: rotate(-2deg);
  transition: transform 200ms ease;
}
.bog-home-hero-card:hover { transform: rotate(0); }
.bog-home-steps li {
  display: flex;
  gap: 12px;
  padding: 10px 0;
  border-bottom: 1px dashed var(--border-light, #ECECED);
}
.bog-home-steps li:last-child { border-bottom: 0; }
.bog-home-step {
  width: 30px;
  height: 30px;
  border-radius: 50%;
  background: var(--brand-50);
  color: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  flex: 0 0 auto;
}
.bog-home-steps small { color: var(--text-tertiary); display: block; margin-top: 2px; }
.bog-home-feature {
  border: 1px solid var(--border-light, #ECECED);
  border-radius: var(--radius-xl, 12px);
  transition: transform 160ms ease, box-shadow 160ms ease;
}
.bog-home-feature:hover {
  transform: translateY(-3px);
  box-shadow: var(--shadow-md, 0 4px 8px -2px rgba(16,24,40,.06));
}
.bog-home-feature-icon {
  width: 48px;
  height: 48px;
  border-radius: var(--radius-md, 8px);
  display: inline-flex;
  align-items: center;
  justify-content: center;
}
.bog-home-feature .bog-home-feature-icon .material-icons { font-size: 26px; }
@@media (max-width: 575.98px) {
  .bog-home-hero { padding: 56px 0 64px; }
  .bog-home-hero h1 { font-size: 1.85rem; }
  .bog-home-hero .lead { font-size: 1rem; }
}
</style>
