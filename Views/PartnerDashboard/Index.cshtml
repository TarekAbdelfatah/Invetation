@model Ibtikar.ViewModels.PartnerDashboardVm
@using Ibtikar.ViewModels
@{
    ViewData["Title"] = "لوحة الشريك";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var deptLabel = string.IsNullOrWhiteSpace(Model.DepartmentName) ? "الإدارة الشريكة" : Model.DepartmentName;
}

<div class="bog-main">
    <div class="container py-4">
        <div class="bog-page-header">
            <h1>
                <span class="bog-page-icon" aria-hidden="true">
                    <span class="material-icons">handshake</span>
                </span>
                لوحة @deptLabel
            </h1>
            <span class="bog-page-role">
                <span class="material-icons" aria-hidden="true">apartment</span>
                @deptLabel
            </span>
        </div>

        @if (TempData["AlertMessage"] is string ok)
        {
            <div class="alert alert-success">@ok</div>
        }
        @if (TempData["AlertError"] is string err)
        {
            <div class="alert alert-danger">@err</div>
        }

        <div class="row g-3 mb-4">
            <div class="col-lg-4 col-md-6">
                <div class="card h-100 bog-kpi-card">
                    <div class="card-body">
                        <div class="bog-kpi-label">إسنادات بانتظار الرد</div>
                        <div class="bog-kpi-value text-warning">@Model.PendingAssignments</div>
                        <div class="bog-kpi-meta">من الإدارة المختصة</div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="card h-100 bog-kpi-card">
                    <div class="card-body">
                        <div class="bog-kpi-label">طلبات متأخرة</div>
                        <div class="bog-kpi-value text-danger">@Model.OverdueLate</div>
                        <div class="bog-kpi-meta">أكثر من 4 أيام</div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="card h-100 bog-kpi-card">
                    <div class="card-body">
                        <div class="bog-kpi-label">تم الرد خلال 30 يوم</div>
                        <div class="bog-kpi-value text-success">@Model.SubmittedThisCycle</div>
                        <div class="bog-kpi-meta">دورة المراجعة</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card bog-section">
            <div class="card-header bg-white d-flex align-items-center gap-2">
                <span class="material-icons text-primary">inbox</span>
                <strong>الإسنادات الحالية</strong>
                <span class="badge bg-secondary ms-auto">@Model.Items.Count</span>
            </div>

            @if (!Model.Items.Any())
            {
                <div class="card-body text-center text-muted p-5">
                    <span class="material-icons" style="font-size:48px;color:var(--text-muted)">inbox</span>
                    <p class="mb-1 mt-2">لا توجد إسنادات حالياً.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="bog-card-list mb-0">
                        <thead>
                            <tr>
                                <th>المرجع</th>
                                <th>العنوان</th>
                                <th>مُقدِّم الفكرة</th>
                                <th>من إدارة</th>
                                <th>منذ الإسناد</th>
                                <th>الحالة</th>
                                <th class="text-end">إجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var i in Model.Items)
                            {
                                <tr class="@(i.IsLate ? "table-warning" : null)">
                                    <td data-label="المرجع"><code>@i.IdeaReference</code></td>
                                    <td data-label="العنوان">@i.IdeaTitle</td>
                                    <td data-label="مُقدِّم الفكرة">@i.ApplicantName</td>
                                    <td data-label="من إدارة">@i.SourceDepartmentName</td>
                                    <td data-label="منذ الإسناد">
                                        <small dir="ltr">@i.DaysOpen.ToString("0.0") يوم</small>
                                    </td>
                                    <td data-label="الحالة">
                                        @if (i.IsReturned)
                                        {
                                            <span class="badge bg-secondary">مرتجَع</span>
                                        }
                                        else if (!i.IsPending)
                                        {
                                            <span class="badge bg-success">تم الرد</span>
                                        }
                                        else if (i.IsLate)
                                        {
                                            <span class="badge bg-danger">متأخر</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">قيد المراجعة</span>
                                        }
                                    </td>
                                    <td class="bog-card-list__actions" data-label="">
                                        <a class="btn btn-sm btn-primary" asp-action="Details" asp-route-assignmentId="@i.AssignmentId">
                                            <span class="material-icons align-middle" style="font-size:16px">rate_review</span>
                                            مراجعة
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>