@model Ibtikar.ViewModels.PartnerDetailsVm
@using Ibtikar.ViewModels
@{
    ViewData["Title"] = $"مراجعة {Model.IdeaReference}";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h2 class="mb-0 d-flex align-items-center gap-2">
            <span class="bog-page-icon" aria-hidden="true">
                <span class="material-icons">rate_review</span>
            </span>
            مراجعة الفكرة
        </h2>
        <a class="btn btn-outline-secondary" asp-controller="SpecializedDashboard" asp-action="Index">
            <span class="material-icons align-middle" style="font-size:18px">arrow_forward</span>
            العودة للوحة الإدارة
        </a>
    </div>

    @if (TempData["AlertMessage"] is string ok)
    {
        <div class="alert alert-success bog-alert" role="alert">
            <span class="material-icons bog-alert-icon">check_circle</span>
            <span class="bog-alert-text">@ok</span>
        </div>
    }
    @if (TempData["AlertError"] is string err)
    {
        <div class="alert alert-danger bog-alert" role="alert">
            <span class="material-icons bog-alert-icon">error</span>
            <span class="bog-alert-text">@err</span>
        </div>
    }

    <div class="partner-summary">
        <div class="d-flex flex-wrap align-items-center gap-3">
            <span class="partner-summary__ref">@Model.IdeaReference</span>
            <span class="partner-summary__badge">
                <span class="material-icons" style="font-size:15px">flag</span>
                @if (Model.IsNotCompetentReturn)
                {
                    <text>معاد — خطأ في التوجيه</text>
                }
                else if (Model.Status == "Submitted")
                {
                    <text>تم الرد</text>
                }
                else if (Model.Status == "Returned")
                {
                    <text>مرتجَع</text>
                }
                else
                {
                    <text>قيد المراجعة</text>
                }
            </span>
        </div>
        <h1 class="partner-summary__title">@Model.IdeaTitle</h1>
    </div>

    @if (Model.IsNotCompetentReturn)
    {
        <div class="partner-misroute" role="alert">
            <span class="material-icons">report_problem</span>
            <div class="flex-grow-1">
                <p class="partner-misroute__title">معاد للإدارة صاحبة الفكرة — خطأ في التوجيه</p>
                @if (!string.IsNullOrWhiteSpace(Model.NotCompetentReason))
                {
                    <div class="partner-misroute__reason">@Model.NotCompetentReason</div>
                }
            </div>
        </div>
    }

    <div class="row g-3">
        <div class="col-lg-7">
            <div class="card bog-section mb-3">
                <div class="card-header bg-white">
                    <span class="material-icons text-primary align-middle">subject</span>
                    <strong class="ms-2">الفكرة</strong>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-3">المُقدِّم</dt>
                        <dd class="col-sm-9">@Model.ApplicantName (@Model.ApplicantDepartmentName)</dd>
                        <dt class="col-sm-3">المجال</dt>
                        <dd class="col-sm-9">@(Model.DomainName ?? "—")</dd>
                        <dt class="col-sm-3">الإدارة الطالبة للرأي</dt>
                        <dd class="col-sm-9">@Model.SourceDepartmentName</dd>
                        <dt class="col-sm-3">الوصف</dt>
                        <dd class="col-sm-9" style="white-space:pre-wrap">@Model.Description</dd>
                        @if (!string.IsNullOrWhiteSpace(Model.ProblemStatement))
                        {
                            <dt class="col-sm-3">التحديات</dt>
                            <dd class="col-sm-9" style="white-space:pre-wrap">@Model.ProblemStatement</dd>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.ProposedSolution))
                        {
                            <dt class="col-sm-3">الحل المقترح</dt>
                            <dd class="col-sm-9" style="white-space:pre-wrap">@Model.ProposedSolution</dd>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.ExpectedBenefits))
                        {
                            <dt class="col-sm-3">الفوائد</dt>
                            <dd class="col-sm-9" style="white-space:pre-wrap">@Model.ExpectedBenefits</dd>
                        }
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card bog-section mb-3">
                <div class="card-header bg-white">
                    <span class="material-icons text-info align-middle">event</span>
                    <strong class="ms-2">التواريخ</strong>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">تاريخ الطلب</dt>
                        <dd class="col-sm-8" dir="ltr">@Model.SentAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</dd>
                        <dt class="col-sm-4">تاريخ الرد</dt>
                        <dd class="col-sm-8" dir="ltr">@(Model.RespondedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "—")</dd>
                        @if (Model.AlreadyScored)
                        {
                            <dt class="col-sm-4">إجمالي الدرجات</dt>
                            <dd class="col-sm-8"><strong>@Model.TotalScore</strong></dd>
                        }
                    </dl>
                </div>
            </div>
        </div>
    </div>

    <div class="partner-specialized">
        <div class="partner-specialized__head">
            <span class="material-icons">fact_check</span>
            <strong>تقييم الإدارة صاحبة الفكرة</strong>
            <span class="partner-specialized__lock">
                <span class="material-icons">lock</span>
                للاطلاع فقط
            </span>
        </div>
        <div class="partner-specialized__body">
            @if (Model.SpecializedAssessment.HasAssessment)
            {
                <div class="partner-specialized__meta">
                    <span class="badge bg-light text-dark border">@Model.SpecializedAssessment.AssessorDepartmentName</span>
                    @if (Model.SpecializedAssessment.SubmittedAt.HasValue)
                    {
                        <small class="text-muted" dir="ltr">@Model.SpecializedAssessment.SubmittedAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</small>
                    }
                    @if (Model.SpecializedAssessment.TotalScore.HasValue)
                    {
                        <span class="partner-specialized__total">@Model.SpecializedAssessment.TotalScore / 25</span>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.SpecializedAssessment.Comment))
                {
                    <p class="mb-2 small text-muted" style="white-space:pre-wrap">@Model.SpecializedAssessment.Comment</p>
                }
                @if (Model.SpecializedAssessment.Scores.Any())
                {
                    <div class="table-responsive">
                        <table class="bog-card-list mb-0">
                            <thead>
                                <tr>
                                    <th>المعيار</th>
                                    <th style="width:120px">الدرجة</th>
                                    <th>تعليق</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var s in Model.SpecializedAssessment.Scores)
                                {
                                    <tr>
                                        <td data-label="المعيار"><strong>@s.CriterionName</strong></td>
                                        <td data-label="الدرجة"><span class="badge bg-primary">@s.Score</span></td>
                                        <td data-label="تعليق" class="small">@(s.Comment ?? "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
            else
            {
                <p class="text-muted mb-0">
                    <span class="material-icons align-middle me-1" style="font-size:18px">info</span>
                    لم تكمل الإدارة صاحبة الفكرة تقييماً لها بعد.
                </p>
            }
        </div>
    </div>

    @if (Model.CanScore)
    {
        <form method="post" asp-action="Submit" id="partner-form" autocomplete="off">
            @Html.AntiForgeryToken()
            <input type="hidden" name="assignmentId" value="@Model.AssignmentId" />

            <div class="partner-assess">
                <div class="partner-assess__head">
                    <span class="material-icons">score</span>
                    <strong>التقييم الاستشاري</strong>
                    <small>رأيك استشاري فقط ولا يحل محل تقييم الإدارة صاحبة الفكرة.</small>
                </div>
                <div class="partner-assess__body">
                    <table class="bog-card-list mb-0">
                        <thead>
                            <tr>
                                <th>المعيار</th>
                                <th style="width:240px">الدرجة (1 - 5)</th>
                                <th>تعليق</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model.Criteria)
                            {
                                var line = Model.ExistingScores.FirstOrDefault(s => s.CriterionId == c.Id);
                                <tr>
                                    <td data-label="المعيار"><strong>@c.Name</strong></td>
                                    <td data-label="الدرجة">
                                        <select name="score_@c.Id" class="form-select form-select-sm partner-score">
                                            <option value="">—</option>
                                            @for (var s = 1; s <= 5; s++)
                                            {
                                                <option value="@s" selected="@(line?.Score == s)">@s</option>
                                            }
                                        </select>
                                    </td>
                                    <td data-label="تعليق">
                                        <input type="text" name="comment_@c.Id" class="form-control form-control-sm" value="@line?.Comment" maxlength="1000" placeholder="اختياري" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card bog-section mb-3">
                <div class="card-header bg-white d-flex align-items-center gap-2">
                    <span class="material-icons text-info align-middle">chat_bubble_outline</span>
                    <strong>تعليق عام</strong>
                </div>
                <div class="card-body">
                    <textarea name="comment" class="form-control" rows="3" maxlength="2000" placeholder="ملاحظاتك الاستشارية…">@Model.Comment</textarea>
                </div>
            </div>

            <div class="partner-actions">
                @if (Model.CanReturnNotCompetent)
                {
                    <button type="button" class="btn btn-outline-danger" data-open-not-competent>
                        <span class="material-icons">report_problem</span>
                        إرجاع لعدم الاختصاص
                    </button>
                }
                <button type="submit" name="returnOnly" value="true" class="btn btn-outline-secondary">
                    <span class="material-icons">undo</span>
                    إرجاع دون تقييم
                </button>
                <button type="submit" name="returnOnly" value="false" class="btn btn-primary">
                    <span class="material-icons">send</span>
                    إرسال التقييم الاستشاري
                </button>
            </div>
        </form>
    }

    @if (Model.CanReturnNotCompetent)
    {
        <div id="notCompetentModal" class="bog-modal" @(Model.ShowNotCompetentModal ? null : "hidden") role="dialog" aria-modal="true"
             aria-labelledby="notCompetentModalTitle">
            <div class="bog-modal-backdrop" data-close-not-competent></div>
            <div class="bog-modal-dialog bog-modal-dialog-centered" role="document">
                <div class="bog-modal-content">
                    <form method="post" asp-action="ReturnNotCompetent" autocomplete="off">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="AssignmentId" />
                        <h5 id="notCompetentModalTitle" class="bog-modal-title">إرجاع الطلب لعدم الاختصاص</h5>
                        <p class="bog-modal-body">
                            مسموح فقط خلال ثلاثة أيام عمل من تاريخ الإسناد. سيظهر للإدارة صاحبة الفكرة شارة حمراء مع سبب الإعادة.
                        </p>
                        <label asp-for="NotCompetentReason" class="form-label">سبب الإعادة (إلزامي)</label>
                        <textarea asp-for="NotCompetentReason" class="form-control mb-3" rows="3" maxlength="2000"></textarea>
                        <span asp-validation-for="NotCompetentReason" class="text-danger"></span>
                        <div class="bog-modal-actions">
                            <button type="button" class="btn btn-outline-secondary" data-close-not-competent>إلغاء</button>
                            <button type="submit" class="btn btn-danger">تأكيد الإعادة</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
    else if (Model.AlreadyScored)
    {
        <div class="card bog-section mb-3">
            <div class="card-header bg-white">
                <span class="material-icons text-primary align-middle">score</span>
                <strong class="ms-2">التقييم المُرسَل</strong>
            </div>
            <div class="card-body p-0">
                <table class="bog-card-list mb-0">
                    <thead>
                        <tr>
                            <th>المعيار</th>
                            <th>الدرجة</th>
                            <th>تعليق</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.ExistingScores)
                        {
                            <tr>
                                <td data-label="المعيار"><strong>@s.CriterionName</strong></td>
                                <td data-label="الدرجة"><span class="badge bg-primary">@s.Score</span></td>
                                <td data-label="تعليق" class="small">@(s.Comment ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        (function () {
            var modal = document.getElementById('notCompetentModal');
            if (!modal) return;

            function open() {
                modal.hidden = false;
                var reason = modal.querySelector('#NotCompetentReason');
                if (reason) setTimeout(function () { reason.focus(); }, 50);
            }

            function close() {
                modal.hidden = true;
            }

            var openTrigger = document.querySelector('[data-open-not-competent]');
            if (openTrigger) openTrigger.addEventListener('click', open);

            if (@(Model.ShowNotCompetentModal ? "true" : "false")) {
                open();
            }

            modal.querySelectorAll('[data-close-not-competent]').forEach(function (el) {
                el.addEventListener('click', close);
            });

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && !modal.hidden) close();
            });
        })();
    </script>
}
