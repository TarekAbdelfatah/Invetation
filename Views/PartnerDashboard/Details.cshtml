@model Ibtikar.ViewModels.PartnerDetailsVm
@using Ibtikar.ViewModels
@{
    ViewData["Title"] = $"مراجعة {Model.IdeaReference}";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="bog-main">
    <div class="container py-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
            <h2 class="mb-0 d-flex align-items-center gap-2">
                <span class="bog-page-icon" aria-hidden="true">
                    <span class="material-icons">rate_review</span>
                </span>
                مراجعة الفكرة
            </h2>
            <a class="btn btn-outline-secondary" asp-action="Index">
                <span class="material-icons align-middle" style="font-size:18px">arrow_forward</span>
                العودة للقائمة
            </a>
        </div>

        @if (TempData["AlertMessage"] is string ok)
        {
            <div class="alert alert-success">@ok</div>
        }
        @if (TempData["AlertError"] is string err)
        {
            <div class="alert alert-danger">@err</div>
        }

        <div class="card bog-section mb-3">
            <div class="card-body d-flex flex-wrap align-items-center gap-2">
                <code class="fs-6">@Model.IdeaReference</code>
                <h1 class="h5 mb-0 ms-2">@Model.IdeaTitle</h1>
                <span class="ms-auto">
                    @if (Model.Status == "Submitted")
                    {
                        <span class="badge bg-success">تم الرد</span>
                    }
                    else if (Model.Status == "Returned")
                    {
                        <span class="badge bg-secondary">مرتجَع</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">قيد المراجعة</span>
                    }
                </span>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-lg-7">
                <div class="card bog-section mb-3">
                    <div class="card-header bg-white">
                        <span class="material-icons text-primary align-middle">subject</span>
                        <strong class="ms-2">الفكرة</strong>
                    </div>
                    <div class="card-body">
                        <dl class="row mb-0">
                            <dt class="col-sm-3">المُقدِّم</dt>
                            <dd class="col-sm-9">@Model.ApplicantName (@Model.ApplicantDepartmentName)</dd>
                            <dt class="col-sm-3">المجال</dt>
                            <dd class="col-sm-9">@(Model.DomainName ?? "—")</dd>
                            <dt class="col-sm-3">المحوَّلة من</dt>
                            <dd class="col-sm-9">@Model.SourceDepartmentName</dd>
                            <dt class="col-sm-3">الوصف</dt>
                            <dd class="col-sm-9" style="white-space:pre-wrap">@Model.Description</dd>
                            @if (!string.IsNullOrWhiteSpace(Model.ProblemStatement))
                            {
                                <dt class="col-sm-3">التحديات</dt>
                                <dd class="col-sm-9" style="white-space:pre-wrap">@Model.ProblemStatement</dd>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.ProposedSolution))
                            {
                                <dt class="col-sm-3">الحل المقترح</dt>
                                <dd class="col-sm-9" style="white-space:pre-wrap">@Model.ProposedSolution</dd>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.ExpectedBenefits))
                            {
                                <dt class="col-sm-3">الفوائد</dt>
                                <dd class="col-sm-9" style="white-space:pre-wrap">@Model.ExpectedBenefits</dd>
                            }
                        </dl>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="card bog-section mb-3">
                    <div class="card-header bg-white">
                        <span class="material-icons text-info align-middle">event</span>
                        <strong class="ms-2">التواريخ</strong>
                    </div>
                    <div class="card-body">
                        <dl class="row mb-0">
                            <dt class="col-sm-4">تاريخ الطلب</dt>
                            <dd class="col-sm-8" dir="ltr">@Model.SentAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</dd>
                            <dt class="col-sm-4">تاريخ الرد</dt>
                            <dd class="col-sm-8" dir="ltr">@(Model.RespondedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "—")</dd>
                            @if (Model.AlreadyScored)
                            {
                                <dt class="col-sm-4">إجمالي الدرجات</dt>
                                <dd class="col-sm-8"><strong>@Model.TotalScore</strong></dd>
                            }
                        </dl>
                    </div>
                </div>
            </div>
        </div>

        @if (Model.CanScore)
        {
            <form method="post" asp-action="Submit" id="partner-form" autocomplete="off">
                @Html.AntiForgeryToken()
                <input type="hidden" name="assignmentId" value="@Model.AssignmentId" />

                <div class="card bog-section mb-3">
                    <div class="card-header bg-white d-flex align-items-center gap-2">
                        <span class="material-icons text-primary">score</span>
                        <strong>التقييم الاستشاري</strong>
                        <small class="text-muted ms-auto">رأيك استشاري فقط ولا يحل محل تقييم الإدارة المختصة.</small>
                    </div>
                    <div class="card-body p-0">
                        <table class="bog-card-list mb-0">
                            <thead>
                                <tr>
                                    <th>المعيار</th>
                                    <th style="width:240px">الدرجة (1 - 5)</th>
                                    <th>تعليق</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in Model.Criteria)
                                {
                                    var line = Model.ExistingScores.FirstOrDefault(s => s.CriterionId == c.Id);
                                    <tr>
                                        <td data-label="المعيار"><strong>@c.Name</strong></td>
                                        <td data-label="الدرجة">
                                            <select name="score_@c.Id" class="form-select form-select-sm partner-score">
                                                <option value="">—</option>
                                                @for (var s = 1; s <= 5; s++)
                                                {
                                                    <option value="@s" selected="@(line?.Score == s)">@s</option>
                                                }
                                            </select>
                                        </td>
                                        <td data-label="تعليق">
                                            <input type="text" name="comment_@c.Id" class="form-control form-control-sm" value="@line?.Comment" maxlength="1000" placeholder="اختياري" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="card bog-section mb-3">
                    <div class="card-header bg-white d-flex align-items-center gap-2">
                        <span class="material-icons text-info">chat_bubble_outline</span>
                        <strong>تعليق عام</strong>
                    </div>
                    <div class="card-body">
                        <textarea name="comment" class="form-control" rows="3" maxlength="2000" placeholder="ملاحظاتك الاستشارية…">@Model.Comment</textarea>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2 justify-content-end">
                    <button type="submit" name="returnOnly" value="true" class="btn btn-outline-secondary">
                        <span class="material-icons align-middle" style="font-size:18px">undo</span>
                        إرجاع دون تقييم
                    </button>
                    <button type="submit" name="returnOnly" value="false" class="btn btn-primary">
                        <span class="material-icons align-middle" style="font-size:18px">send</span>
                        إرسال التقييم الاستشاري
                    </button>
                </div>
            </form>
        }
        else if (Model.AlreadyScored)
        {
            <div class="card bog-section mb-3">
                <div class="card-header bg-white">
                    <span class="material-icons text-primary align-middle">score</span>
                    <strong class="ms-2">التقييم المُرسَل</strong>
                </div>
                <div class="card-body p-0">
                    <table class="bog-card-list mb-0">
                        <thead>
                            <tr>
                                <th>المعيار</th>
                                <th>الدرجة</th>
                                <th>تعليق</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in Model.ExistingScores)
                            {
                                <tr>
                                    <td data-label="المعيار"><strong>@s.CriterionName</strong></td>
                                    <td data-label="الدرجة"><span class="badge bg-primary">@s.Score</span></td>
                                    <td data-label="تعليق" class="small">@(s.Comment ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>