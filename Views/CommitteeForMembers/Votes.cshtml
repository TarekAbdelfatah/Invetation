@model Ibtikar.ViewModels.CommitteeVotesVm
@using Ibtikar.ViewModels
@{
    ViewData["Title"] = "التصويت";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var voteLabels = new Dictionary<string, string>
    {
        ["Agree"] = "أوافق",
        ["Disagree"] = "لا أوافق",
        ["NeedsDevelopment"] = "تحتاج تطوير"
    };
}

<div class="bog-main">
    <div class="container py-4">
        <div class="bog-page-header">
            <h1>
                <span class="bog-page-icon" aria-hidden="true">
                    <span class="material-icons">how_to_vote</span>
                </span>
                التصويت على الأفكار
            </h1>
            <span class="bog-page-role">
                <span class="material-icons" aria-hidden="true">how_to_vote</span>
                عضو لجنة
            </span>
        </div>

        @if (TempData["AlertMessage"] is string ok)
        {
            <div class="alert alert-success">@ok</div>
            TempData.Remove("AlertMessage");
        }
        @if (TempData["AlertError"] is string err)
        {
            <div class="alert alert-danger">@err</div>
            TempData.Remove("AlertError");
        }

        @if (Model.Items.Count == 0)
        {
            <div class="alert alert-light border text-center py-5">
                <span class="material-icons text-muted d-block mb-2" style="font-size:3rem">how_to_vote</span>
                <div class="text-muted">لا توجد أفكار مفتوحة للتصويت حالياً.</div>
            </div>
        }
        else
        {
            <div class="alert alert-info border">
                <span class="material-icons align-middle me-1" style="font-size:18px">info</span>
                لكل عضو تصويت واحد فقط على كل فكرة، ولا يمكن تعديله لاحقاً.
            </div>

            <div class="row g-3">
                @foreach (var i in Model.Items)
                {
                    <div class="col-lg-6">
                        <div class="card h-100">
                            <div class="card-body">
                                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                    <code class="small">@i.Reference</code>
                                    <span class="badge" style="background-color:@i.StatusColor">@i.StatusName</span>
                                </div>
                                <h5 class="card-title">@i.Title</h5>

                                <div class="idea-readonly">
                                    @await Html.PartialAsync("_IdeaReadOnly", i.Idea)
                                </div>

                                @if (i.HasVoted)
                                {
                                    var label = voteLabels.TryGetValue(i.MyVote ?? "", out var l) ? l : i.MyVote;
                                    <div class="alert @(i.MyVote == "Disagree" ? "alert-danger" : "alert-success") mb-0 d-flex align-items-center gap-2">
                                        <span class="material-icons">check_circle</span>
                                        تم التصويت: <strong>@label</strong>
                                    </div>
                                }
                                else
                                {
                                    <form asp-action="SubmitVote" method="post" class="d-flex gap-2 flex-wrap">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="ideaId" value="@i.IdeaId" />
                                        <button type="submit" name="decision" value="Agree" class="btn btn-success btn-sm"
                                                data-confirm-trigger data-confirm-message="هل أنت متأكد من تسجيل تصويتك؟ لا يمكن تعديله لاحقاً.">
                                            أوافق
                                        </button>
                                        @if (Model.IsHead)
                                        {
                                            <button type="submit" name="decision" value="NeedsDevelopment" class="btn btn-warning btn-sm"
                                                    data-confirm-trigger data-confirm-message="هل أنت متأكد من تسجيل تصويتك؟ لا يمكن تعديله لاحقاً.">
                                                تحتاج تطوير
                                            </button>
                                        }
                                        <button type="submit" name="decision" value="Disagree" class="btn btn-danger btn-sm"
                                                data-confirm-trigger data-confirm-message="هل أنت متأكد من تسجيل تصويتك؟ لا يمكن تعديله لاحقاً.">
                                            لا أوافق
                                        </button>
                                        <input type="hidden" name="decision" value="" />
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
