@model Ibtikar.ViewModels.CommitteeDashboardVm
@using Ibtikar.ViewModels
@{
    ViewData["Title"] = "لجنة الابتكار";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="bog-main">
    <div class="container py-4">
        <div class="bog-page-header">
            <h1>
                <span class="bog-page-icon" aria-hidden="true">
                    <span class="material-icons">groups</span>
                </span>
                لجنة الابتكار
            </h1>
            <span class="bog-page-role">
                <span class="material-icons" aria-hidden="true">how_to_vote</span>
                عضو لجنة
            </span>
        </div>

        @if (TempData["AlertMessage"] is string ok)
        {
            <div class="alert alert-success">@ok</div>
        }
        @if (TempData["AlertError"] is string err)
        {
            <div class="alert alert-danger">@err</div>
        }

        <div class="d-flex justify-content-end mb-3 gap-2">
            <a asp-action="Votes" class="btn btn-outline-primary">
                <span class="material-icons align-middle" style="font-size:18px">how_to_vote</span>
                التصويت
            </a>
            <a asp-action="Delegations" class="btn btn-outline-secondary">
                <span class="material-icons align-middle" style="font-size:18px">swap_horiz</span>
                التفويض
            </a>
        </div>
        @if (ViewBag.DatabaseError is string dbErr)
        {
            <div class="alert alert-danger">تعذر الاتصال بقاعدة البيانات: @dbErr</div>
        }

        <div class="row g-3 mb-4">
            <div class="col-lg-3 col-md-6">
                <div class="card h-100 bog-kpi-card">
                    <div class="card-body">
                        <div class="bog-kpi-label">أفكار قيد الدراسة</div>
                        <div class="bog-kpi-value text-primary">@Model.UnderStudy</div>
                        <div class="bog-kpi-meta">محوّلة من الإدارة المختصة</div>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="card h-100 bog-kpi-card">
                    <div class="card-body">
                        <div class="bog-kpi-label">قيد التصويت</div>
                        <div class="bog-kpi-value text-warning">@Model.UnderVoting</div>
                        <div class="bog-kpi-meta">تصويت واحد لكل عضو</div>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="card h-100 bog-kpi-card">
                    <div class="card-body">
                        <div class="bog-kpi-label">أفكار مقبولة</div>
                        <div class="bog-kpi-value text-success">@Model.Accepted</div>
                        <div class="bog-kpi-meta">قبول أو تنفيذ</div>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="card h-100 bog-kpi-card">
                    <div class="card-body">
                        <div class="bog-kpi-label">أفكار مرفوضة</div>
                        <div class="bog-kpi-value text-danger">@Model.Rejected</div>
                        <div class="bog-kpi-meta">رفض فني</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <span class="fw-semibold">الأفكار المحوّلة للجنة</span>
            </div>
            <div class="card-body">
                @if (Model.Items.Count == 0)
                {
                    <div class="text-center text-muted py-4">
                        <span class="material-icons d-block mb-2" style="font-size:3rem">inbox</span>
                        لا توجد أفكار محوّلة للجنة حالياً.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>المرجع</th>
                                    <th>العنوان</th>
                                    <th>مقدم الطلب</th>
                                    <th>الإدارة</th>
                                    <th>الحالة</th>
                                    <th>أيام الانتظار</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var i in Model.Items)
                                {
                                    <tr>
                                        <td class="text-muted small">@i.Reference</td>
                                        <td class="fw-semibold">@i.Title</td>
                                        <td>@(i.ApplicantName ?? "—")</td>
                                        <td>@(i.ApplicantDepartmentName ?? "—")</td>
                                        <td>
                                            <span class="badge" style="background-color:@i.StatusColor">@i.StatusName</span>
                                        </td>
                                        <td class="@(i.IsOverdue ? "text-danger fw-semibold" : "text-muted")">
                                            @Math.Ceiling(i.StayDays).ToString("0") يوم
                                        </td>
                                        <td>
                                            <div class="d-flex gap-1">
                                                <a class="btn btn-sm btn-outline-primary" asp-action="Assess" asp-route-id="@i.IdeaId">
                                                    تقييم
                                                </a>
                                                @if (i.StatusCode == "referred-committee")
                                                {
                                                    <a class="btn btn-sm btn-outline-success" asp-action="Decision" asp-route-id="@i.IdeaId">
                                                        قرار
                                                    </a>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
