@model Ibtikar.ViewModels.CommitteeReferralsVm
@using Ibtikar.ViewModels
@{
    ViewData["Title"] = "الأفكار المحوّلة للجنة";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="bog-main">
    <div class="container py-4">
        <div class="bog-page-header">
            <h1>
                <span class="bog-page-icon" aria-hidden="true">
                    <span class="material-icons">inbox</span>
                </span>
                الأفكار المحوّلة للجنة
            </h1>
            <span class="bog-page-role">
                <span class="material-icons" aria-hidden="true">how_to_vote</span>
                عضو لجنة
            </span>
        </div>

        <div class="d-flex gap-2 mb-3">
            <a asp-action="Referrals" class="btn btn-sm @(Model.StatusFilter == "" ? "btn-primary" : "btn-outline-secondary")">الكل</a>
            <a asp-action="Referrals" asp-route-status="accepted" class="btn btn-sm @(Model.StatusFilter == "accepted" ? "btn-primary" : "btn-outline-secondary")">مقبولة</a>
            <a asp-action="Referrals" asp-route-status="rejected" class="btn btn-sm @(Model.StatusFilter == "rejected" ? "btn-primary" : "btn-outline-secondary")">مرفوضة</a>
        </div>

        @if (Model.Items.Count == 0)
        {
            <div class="alert alert-light border text-center py-5">
                <span class="material-icons text-muted d-block mb-2" style="font-size:3rem">inbox</span>
                <div class="text-muted">لا توجد أفكار في هذه الفئة.</div>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>المرجع</th>
                            <th>العنوان</th>
                            <th>مقدم الطلب</th>
                            <th>الإدارة</th>
                            <th>الحالة</th>
                            <th>أيام الانتظار</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var i in Model.Items)
                        {
                            <tr>
                                <td class="text-muted small">@i.Reference</td>
                                <td class="fw-semibold">@i.Title</td>
                                <td>@(i.ApplicantName ?? "—")</td>
                                <td>@(i.ApplicantDepartmentName ?? "—")</td>
                                <td>
                                    <span class="badge" style="background-color:@i.StatusColor">@i.StatusName</span>
                                </td>
                                <td class="@(i.IsOverdue ? "text-danger fw-semibold" : "text-muted")">
                                    @Math.Ceiling(i.StayDays).ToString("0") يوم
                                </td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <a class="btn btn-sm btn-outline-primary" asp-action="Assess" asp-route-id="@i.IdeaId">
                                            تقييم
                                        </a>
                                        @if (i.StatusCode == "referred-committee")
                                        {
                                            <a class="btn btn-sm btn-outline-success" asp-action="Decision" asp-route-id="@i.IdeaId">
                                                قرار
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
