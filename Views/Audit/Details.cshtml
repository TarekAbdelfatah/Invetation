@using Ibtikar.Controllers
@using Ibtikar.Services.Helpers
@using Ibtikar.ViewModels
@using static Ibtikar.Services.Helpers.KsaTime
@model AuditDetailsVm
@{
    ViewData["Title"] = $"تدقيق {Model.Reference}";
    var impact = !string.IsNullOrWhiteSpace(Model.ExpectedImpactName)
        ? (string.IsNullOrWhiteSpace(Model.ExpectedImpactOther)
            ? Model.ExpectedImpactName
            : $"{Model.ExpectedImpactName} — تفصيل: {Model.ExpectedImpactOther}")
        : (!string.IsNullOrWhiteSpace(Model.ExpectedImpactOther) ? Model.ExpectedImpactOther : "—");
    var audience = !string.IsNullOrWhiteSpace(Model.TargetAudienceName)
        ? (string.IsNullOrWhiteSpace(Model.TargetAudienceOther)
            ? Model.TargetAudienceName
            : $"{Model.TargetAudienceName} — تفصيل: {Model.TargetAudienceOther}")
        : (!string.IsNullOrWhiteSpace(Model.TargetAudienceOther) ? Model.TargetAudienceOther : "—");
    var techText = Model.UsesEmergingTech
        ? (string.IsNullOrWhiteSpace(Model.TechnologyOther) ? "نعم" : "نعم — " + Model.TechnologyOther)
        : "لا";
}

<div class="bog-main">
    <div class="container py-4">
        <div class="bog-page-header">
            <h1>
                <span class="bog-page-icon" aria-hidden="true">
                    <span class="material-icons">fact_check</span>
                </span>
                تدقيق الملف
            </h1>
            <a class="btn btn-outline-secondary" asp-action="Inbox">
                <span class="material-icons align-middle" style="font-size:18px">arrow_forward</span>
                العودة إلى الصندوق
            </a>
        </div>

        <div class="card bog-section mb-3 bog-idea-summary">
            <div class="card-header bg-white d-flex justify-content-between align-items-center flex-wrap gap-2">
                <strong><code class="fs-6">@Model.Reference</code></strong>
                <span class="badge rounded-pill" style="background-color:@Model.StatusColor">@Model.StatusName</span>
            </div>
            @if (Model.IsRouted)
            {
                <div class="bog-routed-banner">
                    <span class="bog-routed-banner__icon">
                        <span class="material-icons">call_split</span>
                    </span>
                    <div>
                        <strong>تم تحويل الملف إلى: @Model.AssignedDepartment</strong>
                        <small>الملف خرج من صندوق التدقيق ويخضع حالياً للجهة المختصة. لا يمكن اتخاذ قرارات تدقيق إضافية.</small>
                    </div>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.LatestCompletionNote))
            {
                <div class="bog-completion-note">
                    <div class="bog-completion-note__head">
                        <span class="bog-completion-note__icon">
                            <span class="material-icons">support_agent</span>
                        </span>
                        <div>
                            <strong>آخر طلب استكمال أرسله المدقق</strong>
                            @if (Model.LatestCompletionNoteAt.HasValue)
                            {
                                <small>بتاريخ <span dir="ltr">@Model.LatestCompletionNoteAt.Value.FormatDateTime()</span></small>
                            }
                        </div>
                    </div>
                    <p class="bog-completion-note__body" style="white-space:pre-line">@Model.LatestCompletionNote</p>
                    <small class="text-muted d-block mt-2">تعليمات الاستكمال التي يحتاجها مقدم الفكرة قبل المتابعة. راجع التاريخ الكامل أدناه لمتابعة كل الرسائل السابقة.</small>
                </div>
            }
            <div class="card-body">
                <h3 class="mb-3">@Model.Title</h3>
                <dl class="row mb-0 bog-idea-summary__list">
                    <dt class="col-sm-3">المجال</dt>
                    <dd class="col-sm-9">@Model.Domain</dd>

                    <dt class="col-sm-3">مقدم الفكرة</dt>
                    <dd class="col-sm-9">@Model.ApplicantName</dd>

                    <dt class="col-sm-3">جهة التقديم</dt>
                    <dd class="col-sm-9">@(Model.ApplicantDepartment == "خارجي" ? "خارج المؤسسة (فردي)" : Model.ApplicantDepartment)</dd>

                    <dt class="col-sm-3">التأثير المتوقع</dt>
                    <dd class="col-sm-9">@impact</dd>

                    <dt class="col-sm-3">الفئة المستهدفة</dt>
                    <dd class="col-sm-9">@audience</dd>

                    <dt class="col-sm-3">تقنية حديثة</dt>
                    <dd class="col-sm-9">@techText</dd>

                    @if (!string.IsNullOrWhiteSpace(Model.AssignedDepartment))
                    {
                        <dt class="col-sm-3">جهة التحويل</dt>
                        <dd class="col-sm-9">@Model.AssignedDepartment</dd>
                    }

                    <dt class="col-sm-3">تاريخ التقديم</dt>
                    <dd class="col-sm-9" dir="ltr">@Model.SubmittedAt.FormatDateTime()</dd>
                </dl>
            </div>
        </div>

        <div class="card bog-section mb-3 bog-idea-section">
            <div class="bog-idea-section__head">
                <span class="bog-idea-section__icon bg-info-subtle text-info">
                    <span class="material-icons">description</span>
                </span>
                <strong>وصف الفكرة</strong>
            </div>
            <div class="card-body bog-idea-section__body">
                <p class="mb-0" style="white-space:pre-line">@Model.Description</p>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.ProblemStatement))
        {
            <div class="card bog-section mb-3 bog-idea-section">
                <div class="bog-idea-section__head">
                    <span class="bog-idea-section__icon bg-warning-subtle text-warning">
                        <span class="material-icons">report_problem</span>
                    </span>
                    <strong>المشكلة</strong>
                </div>
                <div class="card-body bog-idea-section__body">
                    <p class="mb-0" style="white-space:pre-line">@Model.ProblemStatement</p>
                </div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.ProposedSolution))
        {
            <div class="card bog-section mb-3 bog-idea-section">
                <div class="bog-idea-section__head">
                    <span class="bog-idea-section__icon bg-success-subtle text-success">
                        <span class="material-icons">auto_awesome</span>
                    </span>
                    <strong>الحل المقترح</strong>
                </div>
                <div class="card-body bog-idea-section__body">
                    <p class="mb-0" style="white-space:pre-line">@Model.ProposedSolution</p>
                </div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.ExpectedBenefits))
        {
            <div class="card bog-section mb-3 bog-idea-section">
                <div class="bog-idea-section__head">
                    <span class="bog-idea-section__icon bg-primary-subtle text-primary">
                        <span class="material-icons">emoji_events</span>
                    </span>
                    <strong>الفوائد المتوقعة</strong>
                </div>
                <div class="card-body bog-idea-section__body">
                    <p class="mb-0" style="white-space:pre-line">@Model.ExpectedBenefits</p>
                </div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.RequiredResources))
        {
            <div class="card bog-section mb-3 bog-idea-section">
                <div class="bog-idea-section__head">
                    <span class="bog-idea-section__icon bg-secondary-subtle text-secondary">
                        <span class="material-icons">inventory_2</span>
                    </span>
                    <strong>الموارد المطلوبة</strong>
                </div>
                <div class="card-body bog-idea-section__body">
                    <p class="mb-0" style="white-space:pre-line">@Model.RequiredResources</p>
                </div>
            </div>
        }

        <div class="card bog-section mb-3 bog-idea-section">
            <div class="bog-idea-section__head">
                <span class="bog-idea-section__icon bg-danger-subtle text-danger">
                    <span class="material-icons">attach_file</span>
                </span>
                <strong>المرفقات</strong>
                <span class="badge bg-secondary ms-auto">@Model.Attachments.Count</span>
            </div>
            <div class="card-body p-0">
                @if (Model.Attachments.Any())
                {
                    <ul class="bog-attachment-list">
                        @foreach (var a in Model.Attachments)
                        {
                            <li class="bog-attachment-list__item">
                                <span class="bog-attachment-list__icon">
                                    <span class="material-icons">picture_as_pdf</span>
                                </span>
                                <div class="bog-attachment-list__meta">
                                    <strong class="bog-attachment-list__name">@a.FileName</strong>
                                    <small class="text-muted" dir="ltr">@(a.SizeBytes / 1024) KB · @a.UploadedAt.FormatDateTime()</small>
                                </div>
                                <a class="btn btn-sm btn-outline-primary"
                                   href="@Url.Action("Download", "AttachmentDownload", new { attachmentId = a.Id })"
                                   download="@a.FileName" target="_blank" rel="noopener noreferrer">
                                    <span class="material-icons align-middle" style="font-size:16px">download</span>
                                    تحميل
                                </a>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="text-muted text-center p-4">لا توجد مرفقات.</div>
                }
            </div>
        </div>

        @if (Model.CanDecide)
        {
            <div class="card bog-section mb-3 bog-decision">
                <div class="bog-decision__head">
                    <div class="bog-decision__icon">
                        <span class="material-icons">rule</span>
                    </div>
                    <div class="bog-decision__title">
                        <strong>قرار التدقيق</strong>
                        <small>اختر الإجراء المناسب. سيتم تسجيل القرار في سجل الحالات وإبلاغ صاحب الدور تلقائياً.</small>
                    </div>
                </div>

                <div class="bog-decision__body">
                    <article class="bog-decision-card bog-decision-card--success">
                        <header class="bog-decision-card__head">
                                <span class="bog-decision-card__icon">
                                    <span class="material-icons">call_split</span>
                                </span>
                            <div>
                                <h4 class="bog-decision-card__title">تحويل الملف إلى جهة مختصة</h4>
                                <p class="bog-decision-card__hint">اختر الإدارة التي ستستلم الملف لدراسته بشكل أعمق.</p>
                            </div>
                        </header>
                        <form method="post" asp-action="Route" asp-route-id="@Model.Id" class="bog-decision-card__form">
                            @Html.AntiForgeryToken()
                            <label class="form-label small text-muted">الإدارة المختصة</label>
                            <select name="departmentId" class="form-select" required>
                                <option value="">اختر الإدارة...</option>
                                @foreach (var d in Model.ActiveDepartments)
                                {
                                    <option value="@d.Id">@d.Name</option>
                                }
                            </select>
                            <label class="form-label small text-muted mt-3">ملاحظة للجه المختصة (اختياري)</label>
                            <textarea name="decisionText" class="form-control" rows="3"
                                      placeholder="اكتب ملاحظة مختصرة تساعد الجهة في بدء المراجعة..."></textarea>
                            <button type="submit" class="btn btn-success mt-3 w-100 bog-decision-card__btn" id="routeIdeaBtn">
                                <span class="material-icons align-middle" style="font-size:18px">call_split</span>
                                <span>تحويل الجهة المختصة</span>
                            </button>
                        </form>
                    </article>

                    <article class="bog-decision-card bog-decision-card--warning">
                        <header class="bog-decision-card__head">
                                <span class="bog-decision-card__icon">
                                    <span class="material-icons">assignment_return</span>
                                </span>
                            <div>
                                <h4 class="bog-decision-card__title">طلب استكمال البيانات</h4>
                                <p class="bog-decision-card__hint">يطلب من مقدم الفكرة استكمال أو توضيح نقاط محددة قبل المتابعة.</p>
                            </div>
                        </header>
                        <form method="post" asp-action="RequestCompletion" asp-route-id="@Model.Id" class="bog-decision-card__form">
                            @Html.AntiForgeryToken()
                            <label class="form-label small text-muted">تعليمات الاستكمال <span class="text-danger">*</span></label>
                            <textarea name="instructions" class="form-control" rows="4" required minlength="10"
                                      placeholder="اكتب التعليمات التي يحتاجها مقدم الفكرة لاستكمال الملف (10 أحرف على الأقل)..."></textarea>
                            <div class="form-text mb-2">سيتم إرسال هذه التعليمات لمقدم الفكرة وإيقاف الملف مؤقتاً حتى الاستكمال.</div>
                            <button type="submit" class="btn btn-warning mt-2 w-100 bog-decision-card__btn" id="requestCompletionBtn">
                                <span class="material-icons align-middle" style="font-size:18px">assignment_return</span>
                                <span>طلب استكمال البيانات</span>
                            </button>
                        </form>
                    </article>

                    <article class="bog-decision-card bog-decision-card--danger">
                        <header class="bog-decision-card__head">
                                <span class="bog-decision-card__icon">
                                    <span class="material-icons">block</span>
                                </span>
                            <div>
                                <h4 class="bog-decision-card__title">رفض الملف</h4>
                                <p class="bog-decision-card__hint">إنهاء الملف وإبلاغ مقدم الفكرة بسبب الرفض.</p>
                            </div>
                        </header>
                        <form method="post" asp-action="Reject" asp-route-id="@Model.Id" class="bog-decision-card__form">
                            @Html.AntiForgeryToken()
                            <label class="form-label small text-muted">سبب الرفض <span class="text-danger">*</span></label>
                            <textarea name="reason" class="form-control" rows="4" required minlength="10"
                                      placeholder="اشرح أسباب الرفض بوضوح حتى يستفيد منها مقدم الفكرة (10 أحرف على الأقل)..."></textarea>
                            <div class="form-text mb-2">سيتم إشعار مقدم الفكرة بنص الرفض وحفظه في السجل.</div>
                            <button type="submit" class="btn btn-danger mt-2 w-100 bog-decision-card__btn" id="rejectIdeaBtn">
                                <span class="material-icons align-middle" style="font-size:18px">block</span>
                                <span>رفض الملف</span>
                            </button>
                        </form>
                    </article>
                </div>
            </div>
        }

        @if (Model.History.Any())
        {
            <div class="card bog-section mb-3">
                <div class="card-header bg-white d-flex align-items-center gap-2">
                    <span class="material-icons text-primary">history</span>
                    <strong>سجل الحالات</strong>
                    <span class="badge bg-secondary ms-auto">@Model.History.Count</span>
                </div>
                <div class="card-body p-0">
                    <ol class="bog-idea-history">
                        @foreach (var h in Model.History)
                        {
                            <li class="bog-idea-history__item">
                                <div class="bog-idea-history__bullet"><span class="material-icons">circle</span></div>
                                <div class="bog-idea-history__content">
                                    <div class="bog-idea-history__title">
                                        <span>@h.FromStatus</span>
                                        <span class="material-icons bog-idea-history__arrow">arrow_back</span>
                                        <strong>@h.ToStatus</strong>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(h.Note))
                                    {
                                        <div class="bog-idea-history__note">@h.Note</div>
                                    }
                                </div>
                                <div class="bog-idea-history__meta">
                                    <span class="bog-idea-history__date" dir="ltr">@h.ChangedAt.FormatDateTime()</span>
                                    <span class="bog-idea-history__by">@h.By</span>
                                </div>
                            </li>
                        }
                    </ol>
                </div>
            </div>
        }

        @if (Model.IsTerminal)
        {
            <div class="alert alert-secondary mb-3" role="alert">
                هذا الملف في حالة نهائية (<strong>@Model.StatusName</strong>) ولم يعد متاحاً لإجراءات التدقيق.
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const forms = [
                { btnId: 'routeIdeaBtn' },
                { btnId: 'requestCompletionBtn' },
                { btnId: 'rejectIdeaBtn' }
            ];
            for (const { btnId } of forms) {
                const btn = document.getElementById(btnId);
                if (btn) {
                    const form = btn.closest('form');
                    if (form) {
                        form.addEventListener('submit', function () {
                            btn.disabled = true;
                            btn.innerHTML = '<span class="spinner-border spinner-border-sm align-middle"></span> جاري الإرسال...';
                        });
                    }
                }
            }
        })();
    </script>
}