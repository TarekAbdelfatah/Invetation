@using Ibtikar.Controllers
@using Ibtikar.Services.Ideas
@model AuditDetailsVm
@{
    ViewData["Title"] = $"تدقيق {Model.Reference}";
}

<div class="bog-main">
    <div class="container py-4">
        <div class="bog-page-header">
            <h1>
                <span class="bog-page-icon" aria-hidden="true">
                    <span class="material-icons">fact_check</span>
                </span>
                تدقيق الملف
            </h1>
            <a class="btn btn-outline-secondary" asp-action="Inbox">
                <span class="material-icons align-middle" style="font-size:18px">arrow_forward</span>
                العودة إلى الصندوق
            </a>
        </div>

        <div class="card bog-section mb-3 bog-idea-summary">
            <div class="card-header bg-white d-flex justify-content-between align-items-center flex-wrap gap-2">
                <strong><code class="fs-6">@Model.Reference</code></strong>
                <span class="badge rounded-pill" style="background-color:@Model.StatusColor">@Model.StatusName</span>
            </div>
            <div class="card-body">
                <h3 class="mb-3">@Model.Title</h3>
                <dl class="row mb-0 bog-idea-summary__list">
                    <dt class="col-sm-3">المجال</dt>
                    <dd class="col-sm-9">@Model.Domain</dd>

                    <dt class="col-sm-3">مقدم الفكرة</dt>
                    <dd class="col-sm-9">@Model.ApplicantName</dd>

                    <dt class="col-sm-3">جهة التقديم</dt>
                    <dd class="col-sm-9">@(Model.ApplicantDepartment == "خارجي" ? "خارج المؤسسة (فردي)" : Model.ApplicantDepartment)</dd>

                    @if (!string.IsNullOrWhiteSpace(Model.AssignedDepartment))
                    {
                        <dt class="col-sm-3">جهة التحويل</dt>
                        <dd class="col-sm-9">@Model.AssignedDepartment</dd>
                    }

                    <dt class="col-sm-3">تاريخ التقديم</dt>
                    <dd class="col-sm-9" dir="ltr">@Model.SubmittedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</dd>
                </dl>
            </div>
        </div>

        <div class="card bog-section mb-3 bog-idea-section">
            <div class="bog-idea-section__head">
                <span class="bog-idea-section__icon bg-info-subtle text-info">
                    <span class="material-icons">description</span>
                </span>
                <strong>وصف الفكرة</strong>
            </div>
            <div class="card-body bog-idea-section__body">
                <p class="mb-0">@Model.Description</p>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.ProblemStatement))
        {
            <div class="card bog-section mb-3 bog-idea-section">
                <div class="bog-idea-section__head">
                    <span class="bog-idea-section__icon bg-warning-subtle text-warning">
                        <span class="material-icons">report_problem</span>
                    </span>
                    <strong>المشكلة</strong>
                </div>
                <div class="card-body bog-idea-section__body">
                    <p class="mb-0">@Model.ProblemStatement</p>
                </div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.ProposedSolution))
        {
            <div class="card bog-section mb-3 bog-idea-section">
                <div class="bog-idea-section__head">
                    <span class="bog-idea-section__icon bg-success-subtle text-success">
                        <span class="material-icons">auto_awesome</span>
                    </span>
                    <strong>الحل المقترح</strong>
                </div>
                <div class="card-body bog-idea-section__body">
                    <p class="mb-0">@Model.ProposedSolution</p>
                </div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.ExpectedBenefits))
        {
            <div class="card bog-section mb-3 bog-idea-section">
                <div class="bog-idea-section__head">
                    <span class="bog-idea-section__icon bg-primary-subtle text-primary">
                        <span class="material-icons">emoji_events</span>
                    </span>
                    <strong>الفوائد المتوقعة</strong>
                </div>
                <div class="card-body bog-idea-section__body">
                    <p class="mb-0">@Model.ExpectedBenefits</p>
                </div>
            </div>
        }

        @if (Model.CanOpen)
        {
            <div class="card bog-section mb-3 bog-idea-action bog-idea-action--primary">
                <div class="bog-idea-action__head">
                    <span class="bog-idea-action__icon bg-primary-subtle text-primary">
                        <span class="material-icons">play_circle</span>
                    </span>
                    <div class="bog-idea-action__title">
                        <strong>بدء الدراسة</strong>
                        <small>قم بفتح الملف وبدء دراسته قبل اتخاذ أي قرار تدقيقي.</small>
                    </div>
                </div>
                <form method="post" asp-action="Open" asp-route-id="@Model.Id" class="bog-idea-action__form">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-primary btn-lg w-100" id="openIdeaBtn">
                        <span class="material-icons align-middle" style="font-size:18px">play_circle</span>
                        <span>فتح الملف وبدء الدراسة</span>
                    </button>
                </form>
            </div>
        }

        @if (Model.IsUnderStudy)
        {
            <div class="card bog-section mb-3 bog-idea-action bog-idea-action--success">
                <div class="bog-idea-action__head">
                    <span class="bog-idea-action__icon bg-success-subtle text-success">
                        <span class="material-icons">rule</span>
                    </span>
                    <div class="bog-idea-action__title">
                        <strong>قرار التدقيق</strong>
                        <small>اختر الإجراء المناسب. كل قرار يُسجَّل في سجل الحالات ويُعلم صاحب الدور.</small>
                    </div>
                </div>

                <div class="bog-idea-action__form">
                    <form method="post" asp-action="Route" asp-route-id="@Model.Id" class="bog-idea-action__item">
                        @Html.AntiForgeryToken()
                        <div class="bog-idea-action__item-head">
                            <span class="material-icons text-success">call_split</span>
                            <strong>تحويل الملف إلى جهة مختصة</strong>
                        </div>
                        <label class="form-label small text-muted">الإدارة المختصة</label>
                        <select name="departmentId" class="form-select" required>
                            <option value="">اختر الإدارة...</option>
                            @foreach (var d in Model.ActiveDepartments)
                            {
                                <option value="@d.Id">@d.Name</option>
                            }
                        </select>
                        <label class="form-label small text-muted mt-2">ملاحظة (اختياري)</label>
                        <input name="decisionText" class="form-control" placeholder="اكتب ملاحظة للجه المختصة..." />
                        <button type="submit" class="btn btn-success mt-3 w-100" id="routeIdeaBtn">
                            <span class="material-icons align-middle" style="font-size:18px">call_split</span>
                            <span>تحويل</span>
                        </button>
                    </form>

                    <form method="post" asp-action="RequestCompletion" asp-route-id="@Model.Id" class="bog-idea-action__item">
                        @Html.AntiForgeryToken()
                        <div class="bog-idea-action__item-head">
                            <span class="material-icons text-warning">assignment_return</span>
                            <strong>طلب استكمال البيانات</strong>
                        </div>
                        <label class="form-label small text-muted">تعليمات الاستكمال</label>
                        <input name="instructions" class="form-control" placeholder="اكتب التعليمات (10 أحرف على الأقل)..." required minlength="10" />
                        <button type="submit" class="btn btn-warning mt-3 w-100" id="requestCompletionBtn">
                            <span class="material-icons align-middle" style="font-size:18px">assignment_return</span>
                            <span>طلب استكمال</span>
                        </button>
                    </form>

                    <form method="post" asp-action="Reject" asp-route-id="@Model.Id" class="bog-idea-action__item">
                        @Html.AntiForgeryToken()
                        <div class="bog-idea-action__item-head">
                            <span class="material-icons text-danger">block</span>
                            <strong>رفض الملف</strong>
                        </div>
                        <label class="form-label small text-muted">سبب الرفض</label>
                        <input name="reason" class="form-control" placeholder="اكتب سبب الرفض (10 أحرف على الأقل)..." required minlength="10" />
                        <button type="submit" class="btn btn-danger mt-3 w-100" id="rejectIdeaBtn">
                            <span class="material-icons align-middle" style="font-size:18px">block</span>
                            <span>رفض</span>
                        </button>
                    </form>
                </div>
            </div>
        }

        @if (Model.History.Any())
        {
            <div class="card bog-section mb-3">
                <div class="card-header bg-white d-flex align-items-center gap-2">
                    <span class="material-icons text-primary">history</span>
                    <strong>سجل الحالات</strong>
                    <span class="badge bg-secondary ms-auto">@Model.History.Count</span>
                </div>
                <div class="card-body p-0">
                    <ol class="bog-idea-history">
                        @foreach (var h in Model.History)
                        {
                            <li class="bog-idea-history__item">
                                <div class="bog-idea-history__bullet"><span class="material-icons">circle</span></div>
                                <div class="bog-idea-history__content">
                                    <div class="bog-idea-history__title">
                                        <span>@h.FromStatus</span>
                                        <span class="material-icons bog-idea-history__arrow">arrow_back</span>
                                        <strong>@h.ToStatus</strong>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(h.Note))
                                    {
                                        <div class="bog-idea-history__note">@h.Note</div>
                                    }
                                </div>
                                <div class="bog-idea-history__meta">
                                    <span class="bog-idea-history__date" dir="ltr">@h.ChangedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                                    <span class="bog-idea-history__by">@h.By</span>
                                </div>
                            </li>
                        }
                    </ol>
                </div>
            </div>
        }

        @if (Model.IsTerminal)
        {
            <div class="alert alert-secondary mb-3" role="alert">
                هذا الملف في حالة نهائية (<strong>@Model.StatusName</strong>) ولم يعد متاحاً لإجراءات التدقيق.
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const forms = [
                { btnId: 'openIdeaBtn' },
                { btnId: 'routeIdeaBtn' },
                { btnId: 'requestCompletionBtn' },
                { btnId: 'rejectIdeaBtn' }
            ];
            for (const { btnId } of forms) {
                const btn = document.getElementById(btnId);
                if (btn) {
                    const form = btn.closest('form');
                    if (form) {
                        form.addEventListener('submit', function () {
                            btn.disabled = true;
                            btn.innerHTML = '<span class="spinner-border spinner-border-sm align-middle"></span> جاري الإرسال...';
                        });
                    }
                }
            }
        })();
    </script>
}
