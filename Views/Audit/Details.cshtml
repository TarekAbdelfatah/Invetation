@using Ibtikar.Controllers
@using Ibtikar.Services.Ideas
@model AuditDetailsVm
@{
    ViewData["Title"] = $"تدقيق {Model.Reference}";
}

<div class="bog-main">
    <div class="container py-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
            <h2 class="mb-0 d-flex align-items-center gap-2">
                <span class="bog-page-icon" aria-hidden="true">
                    <span class="material-icons">fact_check</span>
                </span>
                تدقيق الملف
            </h2>
            <a class="btn btn-outline-secondary" asp-action="Inbox">
                <span class="material-icons align-middle" style="font-size:18px">arrow_forward</span>
                العودة إلى الصندوق
            </a>
        </div>

        <div class="card bog-section mb-3">
            <div class="card-header bg-white d-flex justify-content-between align-items-center flex-wrap gap-2">
                <strong><code class="fs-6">@Model.Reference</code></strong>
                <span class="badge rounded-pill" style="background-color:@Model.StatusColor">@Model.StatusName</span>
            </div>
            <div class="card-body">
                <h3 class="mb-3">@Model.Title</h3>
                <dl class="row mb-0">
                    <dt class="col-sm-3">المجال</dt>
                    <dd class="col-sm-9">@Model.Domain</dd>

                    <dt class="col-sm-3">مقدم الفكرة</dt>
                    <dd class="col-sm-9">@Model.ApplicantName</dd>

                    <dt class="col-sm-3">جهة التقديم</dt>
                    <dd class="col-sm-9">@(Model.ApplicantDepartment == "خارجي" ? "خارج المؤسسة (فردي)" : Model.ApplicantDepartment)</dd>

                    @if (!string.IsNullOrWhiteSpace(Model.AssignedDepartment))
                    {
                        <dt class="col-sm-3">جهة التحويل</dt>
                        <dd class="col-sm-9">@Model.AssignedDepartment</dd>
                    }

                    <dt class="col-sm-3">تاريخ التقديم</dt>
                    <dd class="col-sm-9" dir="ltr">@Model.SubmittedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</dd>
                </dl>
            </div>
        </div>

        <div class="card bog-section mb-3">
            <div class="card-header bg-white"><strong>وصف الفكرة</strong></div>
            <div class="card-body">
                <p class="mb-0" style="white-space:pre-line">@Model.Description</p>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.ProblemStatement))
        {
            <div class="card bog-section mb-3">
                <div class="card-header bg-white"><strong>المشكلة</strong></div>
                <div class="card-body"><p class="mb-0" style="white-space:pre-line">@Model.ProblemStatement</p></div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.ProposedSolution))
        {
            <div class="card bog-section mb-3">
                <div class="card-header bg-white"><strong>الحل المقترح</strong></div>
                <div class="card-body"><p class="mb-0" style="white-space:pre-line">@Model.ProposedSolution</p></div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.ExpectedBenefits))
        {
            <div class="card bog-section mb-3">
                <div class="card-header bg-white"><strong>الفوائد المتوقعة</strong></div>
                <div class="card-body"><p class="mb-0" style="white-space:pre-line">@Model.ExpectedBenefits</p></div>
            </div>
        }

        @if (Model.CanOpen)
        {
            <div class="card bog-section mb-3 border-primary">
                <div class="card-header bg-white"><strong>بدء الدراسة</strong></div>
                <div class="card-body">
                    <p class="text-muted mb-3">قم بفتح الملف وبدء دراسته قبل اتخاذ أي قرار تدقيقي.</p>
                    <form method="post" asp-action="Open" asp-route-id="@Model.Id">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-primary btn-lg" id="openIdeaBtn">
                            <span class="material-icons align-middle" style="font-size:18px">play_circle</span>
                            فتح الملف وبدء الدراسة
                        </button>
                    </form>
                </div>
            </div>
        }

        @if (Model.IsUnderStudy)
        {
            <div class="card bog-section mb-3 border-success">
                <div class="card-header bg-white"><strong>قرار التدقيق</strong></div>
                <div class="card-body">
                    <div class="mb-4">
                        <h6 class="text-muted">تحويل الملف إلى جهة مختصة</h6>
                        <form method="post" asp-action="Route" asp-route-id="@Model.Id" class="row g-2">
                            @Html.AntiForgeryToken()
                            <div class="col-md-5">
                                <select name="departmentId" class="form-select" required>
                                    <option value="">اختر الإدارة...</option>
                                    @foreach (var d in Model.ActiveDepartments)
                                    {
                                        <option value="@d.Id">@d.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-5">
                                <input name="decisionText" class="form-control" placeholder="ملاحظة (اختياري)" />
                            </div>
                            <div class="col-md-2 d-grid">
                                <button type="submit" class="btn btn-success" id="routeIdeaBtn">
                                    <span class="material-icons align-middle" style="font-size:18px">call_split</span>
                                    تحويل
                                </button>
                            </div>
                        </form>
                    </div>

                    <hr />

                    <div class="mb-4">
                        <h6 class="text-muted">طلب استكمال البيانات من مقدم الفكرة</h6>
                        <form method="post" asp-action="RequestCompletion" asp-route-id="@Model.Id" class="row g-2">
                            @Html.AntiForgeryToken()
                            <div class="col-md-10">
                                <input name="instructions" class="form-control" placeholder="تعليمات الاستكمال (مطلوبة)" required minlength="10" />
                            </div>
                            <div class="col-md-2 d-grid">
                                <button type="submit" class="btn btn-warning" id="requestCompletionBtn">
                                    <span class="material-icons align-middle" style="font-size:18px">assignment_return</span>
                                    طلب استكمال
                                </button>
                            </div>
                        </form>
                    </div>

                    <hr />

                    <h6 class="text-muted">رفض الملف</h6>
                    <form method="post" asp-action="Reject" asp-route-id="@Model.Id" class="row g-2">
                        @Html.AntiForgeryToken()
                        <div class="col-md-10">
                            <input name="reason" class="form-control" placeholder="سبب الرفض (مطلوب، 10 أحرف على الأقل)" required minlength="10" />
                        </div>
                        <div class="col-md-2 d-grid">
                            <button type="submit" class="btn btn-danger" id="rejectIdeaBtn">
                                <span class="material-icons align-middle" style="font-size:18px">block</span>
                                رفض
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        }

        @if (Model.History.Any())
        {
            <div class="card bog-section mb-3">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <strong>سجل الحالات</strong>
                    <span class="badge bg-secondary">@Model.History.Count</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>الوقت</th>
                                    <th>من</th>
                                    <th>إلى</th>
                                    <th>بواسطة</th>
                                    <th>ملاحظة</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var h in Model.History)
                                {
                                    <tr>
                                        <td class="text-nowrap"><small dir="ltr">@h.ChangedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</small></td>
                                        <td><small>@h.FromStatus</small></td>
                                        <td><small>@h.ToStatus</small></td>
                                        <td><small>@h.By</small></td>
                                        <td><small>@(string.IsNullOrWhiteSpace(h.Note) ? "—" : h.Note)</small></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

        @if (Model.IsTerminal)
        {
            <div class="alert alert-secondary mb-3" role="alert">
                هذا الملف في حالة نهائية (<strong>@Model.StatusName</strong>) ولم يعد متاحاً لإجراءات التدقيق.
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const forms = [
                { formId: null, btnId: 'openIdeaBtn' },
                { formId: null, btnId: 'routeIdeaBtn' },
                { formId: null, btnId: 'requestCompletionBtn' },
                { formId: null, btnId: 'rejectIdeaBtn' }
            ];
            for (const { btnId } of forms) {
                const btn = document.getElementById(btnId);
                if (btn) {
                    const form = btn.closest('form');
                    if (form) {
                        form.addEventListener('submit', function () {
                            btn.disabled = true;
                            btn.innerHTML = '<span class="spinner-border spinner-border-sm align-middle"></span> جاري الإرسال...';
                        });
                    }
                }
            }
        })();
    </script>
}
