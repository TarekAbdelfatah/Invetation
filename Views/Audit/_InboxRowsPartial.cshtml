@using Ibtikar.Controllers
@using Ibtikar.ViewModels
@using static Ibtikar.Services.Helpers.KsaTime
@model List<AuditInboxVm.Row>
@{
    var hasItems = Model is { Count: > 0 };
}
@if (hasItems)
{
    @foreach (var i in Model)
    {
        <tr class="@(i.IsOverdue ? "table-danger" : null)" data-inbox-row>
            <td data-label="المرجع"><code>@i.Reference</code></td>
            <td data-label="العنوان">@i.Title</td>
            <td class="d-none d-lg-table-cell" data-label="المجال"><small>@i.Domain</small></td>
            <td data-label="الإدارة"><small>@i.Department</small></td>
            <td class="d-none d-md-table-cell" data-label="تاريخ التقديم"><small dir="ltr">@i.SubmittedAt.FormatDateTime()</small></td>
            <td class="bog-card-list__actions" data-label="">
                @if (i.IsOverdue)
                {
                    <span class="badge bg-danger mb-1 d-inline-flex align-items-center gap-1" title="لم تتم مراجعة الفكرة منذ أكثر من 48 ساعة">
                        <span class="material-icons" style="font-size:14px">priority_high</span>
                        متأخر
                    </span>
                }
                <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@i.Id">
                    <span class="material-icons align-middle" style="font-size:16px">visibility</span>
                    مراجعة
                </a>
            </td>
        </tr>
    }
}
else
{
    <tr data-empty-inbox-row>
        <td colspan="6" class="text-center text-muted p-5">
            <span class="material-icons" style="font-size:48px;color:var(--text-muted)">inbox</span>
            <p class="mb-0 mt-2" data-empty-inbox>لا توجد أفكار بانتظار المراجعة.</p>
        </td>
    </tr>
}
