@using Ibtikar.Controllers
@using Ibtikar.ViewModels
@model AdminOverviewVm
@{
    ViewData["Title"] = "نظرة عامة على النظام";
}

<div class="bog-main">
    <div class="container py-4">
        <div class="bog-page-header">
            <h1>
                <span class="bog-page-icon" aria-hidden="true">
                    <span class="material-icons">monitoring</span>
                </span>
                نظرة عامة على النظام
            </h1>
            <span class="bog-page-role">
                <span class="material-icons" aria-hidden="true">person</span>
                مدير النظام
            </span>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-3 col-sm-6">
                <div class="card h-100 bog-kpi-card">
                    <div class="card-body">
                        <div class="bog-kpi-label">إجمالي الأفكار</div>
                        <div class="bog-kpi-value">@Model.TotalIdeas</div>
                        <div class="bog-kpi-meta">جميع الحالات</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="card h-100 bog-kpi-card">
                    <div class="card-body">
                        <div class="bog-kpi-label">المسودات</div>
                        <div class="bog-kpi-value text-warning">@Model.Drafts</div>
                        <div class="bog-kpi-meta">غير مُرسلة بعد</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="card h-100 bog-kpi-card">
                    <div class="card-body">
                        <div class="bog-kpi-label">المُرسلة</div>
                        <div class="bog-kpi-value text-success">@Model.Submitted</div>
                        <div class="bog-kpi-meta">في دورة المراجعة</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="card h-100 bog-kpi-card">
                    <div class="card-body">
                        <div class="bog-kpi-label">المستخدمون النشطون</div>
                        <div class="bog-kpi-value">@Model.TotalUsers</div>
                        <div class="bog-kpi-meta">من جميع الأدوار</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-lg-7">
                <div class="card bog-section">
                    <div class="card-header bg-white d-flex align-items-center gap-2">
                        <span class="material-icons text-primary">history</span>
                        <strong>أحدث الأفكار</strong>
                    </div>
                    <div class="card-body p-0">
                        @if (Model.Recent.Any())
                        {
                            <div class="bog-mobile-cards d-md-none">
                                @foreach (var r in Model.Recent)
                                {
                                    <div class="bog-idea-card">
                                        <div class="bog-idea-card__head">
                                            <span class="bog-idea-card__ref"><code>@r.Reference</code></span>
                                            <span class="bog-idea-card__status" style="--chip-bg:@r.StatusColor">
                                                <span class="bog-idea-card__status-dot" style="background-color:@r.StatusColor"></span>
                                                @r.StatusName
                                            </span>
                                        </div>
                                        <h3 class="bog-idea-card__title">@r.Title</h3>
                                        <div class="bog-idea-card__foot">
                                            <small class="bog-idea-card__date">
                                                <span class="material-icons" style="font-size:14px">apartment</span>
                                                @r.Domain
                                            </small>
                                            <small class="bog-idea-card__date">
                                                <span class="material-icons" style="font-size:14px">event</span>
                                                @r.CreatedAt.ToString("yyyy-MM-dd")
                                            </small>
                                        </div>
                                    </div>
                                }
                            </div>

                            <div class="table-responsive d-none d-md-block">
                                <table class="bog-card-list">
                                    <thead>
                                        <tr>
                                            <th>المرجع</th>
                                            <th>العنوان</th>
                                            <th>المجال</th>
                                            <th>الحالة</th>
                                            <th>التاريخ</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var r in Model.Recent)
                                        {
                                            <tr>
                                                <td data-label="المرجع"><code>@r.Reference</code></td>
                                                <td data-label="العنوان">@r.Title</td>
                                                <td data-label="المجال"><small>@r.Domain</small></td>
                                                <td data-label="الحالة"><span class="badge rounded-pill" style="background-color:@r.StatusColor">@r.StatusName</span></td>
                                                <td data-label="التاريخ"><small>@r.CreatedAt.ToString("yyyy-MM-dd")</small></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center text-muted p-4">لا توجد أفكار بعد.</div>
                        }
                    </div>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="card bog-section">
                    <div class="card-header bg-white d-flex align-items-center gap-2">
                        <span class="material-icons text-primary">donut_large</span>
                        <strong>توزيع الأفكار حسب الحالة</strong>
                    </div>
                    <div class="card-body">
                        @foreach (var s in Model.ByStatus)
                        {
                            <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                <span class="d-flex align-items-center gap-2">
                                    <span class="bog-status-dot" style="background-color:@s.Color"></span>
                                    @s.Name
                                </span>
                                <span class="fw-semibold">@s.Count</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="alert alert-light border mt-4 d-flex align-items-start gap-2">
            <span class="material-icons text-muted">info</span>
            <div class="text-muted small">
                <strong>ملاحظة:</strong> لوحة مدير النظام للقراءة فقط. لا توجد إجراءات تعديل من هذه الصفحة.
                للوصول إلى الإحصاءات التفصيلية، راجع التقارير عند توفّرها.
            </div>
        </div>
    </div>
</div>
