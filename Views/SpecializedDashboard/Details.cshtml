@model Ibtikar.ViewModels.SpecializedDetailsVm
@using Ibtikar.ViewModels
@using Ibtikar.Services.Helpers
@using static Ibtikar.Services.Helpers.KsaTime
@{
    ViewData["Title"] = $"تفاصيل {Model.Reference}";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var canAssess = Model.StatusCode == IdeaStatusCodes.UnderStudy;
}

<div class="bog-main">
    <div class="container py-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
            <h2 class="mb-0 d-flex align-items-center gap-2">
                <span class="bog-page-icon" aria-hidden="true">
                    <span class="material-icons">description</span>
                </span>
                تفاصيل الفكرة
            </h2>
            <div class="d-flex gap-2">
                <a class="btn btn-outline-secondary" asp-action="Index">
                    <span class="material-icons align-middle" style="font-size:18px">arrow_forward</span>
                    العودة للوحة التحكم
                </a>
                @if (canAssess)
                {
                    <a class="btn btn-primary" asp-action="Assess" asp-route-id="@Model.Id">
                        <span class="material-icons align-middle" style="font-size:18px">edit_note</span>
                        تقييم الفكرة
                    </a>
                }
            </div>
        </div>

        <div class="card bog-section mb-3">
            <div class="card-body p-4">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                    <code class="fs-6">@Model.Reference</code>
                    <span class="status-badge badge rounded-pill" style="background-color:@Model.StatusColor">@Model.StatusName</span>
                    <span class="text-muted small">| مُقدِّمة: @Model.ApplicantName (@Model.ApplicantDepartmentName)</span>
                </div>
                <h1 class="h3 mb-0">@Model.Title</h1>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-lg-8">
                <div class="card bog-section mb-3">
                    <div class="card-header bg-white">
                        <span class="material-icons text-primary align-middle">subject</span>
                        <strong class="ms-2">وصف الفكرة</strong>
                    </div>
                    <div class="card-body">
                        <p class="mb-0" style="white-space:pre-wrap">@Model.Description</p>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.ProblemStatement))
                {
                    <div class="card bog-section mb-3">
                        <div class="card-header bg-white">
                            <span class="material-icons text-warning align-middle">error_outline</span>
                            <strong class="ms-2">التحديات الحالية</strong>
                        </div>
                        <div class="card-body">
                            <p class="mb-0" style="white-space:pre-wrap">@Model.ProblemStatement</p>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.ProposedSolution) || !string.IsNullOrWhiteSpace(Model.ExpectedBenefits))
                {
                    <div class="card bog-section mb-3">
                        <div class="card-header bg-white">
                            <span class="material-icons text-success align-middle">lightbulb</span>
                            <strong class="ms-2">الحل المقترح والفوائد</strong>
                        </div>
                        <div class="card-body">
                            @if (!string.IsNullOrWhiteSpace(Model.ProposedSolution))
                            {
                                <h6 class="text-muted">الحل المقترح</h6>
                                <p style="white-space:pre-wrap">@Model.ProposedSolution</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.ExpectedBenefits))
                            {
                                <h6 class="text-muted">الفوائد المتوقعة</h6>
                                <p style="white-space:pre-wrap">@Model.ExpectedBenefits</p>
                            }
                        </div>
                    </div>
                }

                <div class="card bog-section mb-3">
                    <div class="card-header bg-white">
                        <span class="material-icons text-secondary align-middle">info</span>
                        <strong class="ms-2">التصنيف</strong>
                    </div>
                    <div class="card-body">
                        <dl class="row mb-0">
                            <dt class="col-sm-3">المجال</dt>
                            <dd class="col-sm-9">@(Model.DomainName ?? "—")</dd>
                            <dt class="col-sm-3">الأثر المتوقع</dt>
                            <dd class="col-sm-9">@(Model.ExpectedImpactName ?? "—")</dd>
                            <dt class="col-sm-3">الفئة المستهدفة</dt>
                            <dd class="col-sm-9">@(Model.TargetAudienceName ?? "—")</dd>
                        </dl>
                    </div>
                </div>

                @if (Model.Attachments.Any())
                {
                    <div class="card bog-section mb-3">
                        <div class="card-header bg-white d-flex align-items-center gap-2">
                            <span class="material-icons text-primary align-middle">attach_file</span>
                            <strong class="ms-2">المرفقات</strong>
                            <span class="badge bg-secondary ms-auto">@Model.Attachments.Count</span>
                        </div>
                        <ul class="list-group list-group-flush">
                            @foreach (var a in Model.Attachments)
                            {
                                <li class="list-group-item d-flex align-items-center gap-2">
                                    <span class="material-icons text-muted">picture_as_pdf</span>
                                    <span class="text-break">@a.FileName</span>
                                    <small class="text-muted ms-auto">
                                        @((a.SizeBytes / 1024.0).ToString("0.0")) KB · @a.UploadedAt.FormatDateTime()
                                    </small>
                                    <a class="btn btn-sm btn-outline-primary"
                                       href="@Url.Action("Download", "AttachmentDownload", new { attachmentId = a.Id })"
                                       download="@a.FileName" target="_blank" rel="noopener noreferrer">
                                        <span class="material-icons align-middle" style="font-size:16px">download</span>
                                        تحميل
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>

            <div class="col-lg-4">
                @if (canAssess)
                {
                    <div class="card bog-section mb-3">
                        <div class="card-body">
                            <h6 class="text-muted">خطوات العمل</h6>
                            <div class="d-flex flex-column gap-2">
                                <a class="btn btn-outline-primary" asp-action="Assess" asp-route-id="@Model.Id">
                                    <span class="material-icons align-middle" style="font-size:16px">edit_note</span>
                                    تقييم الفكرة
                                </a>
                                <a class="btn btn-outline-secondary" asp-action="Request" asp-route-id="@Model.Id">
                                    <span class="material-icons align-middle" style="font-size:16px">groups</span>
                                    طلب رأي جهات أخرى
                                </a>
                                <a class="btn btn-outline-secondary" asp-action="PartnerOpinion" asp-route-id="@Model.Id">
                                    <span class="material-icons align-middle" style="font-size:16px">forum</span>
                                    متابعة ردود الجهات المستشارة
                                </a>
                                <button type="button"
                                        class="btn btn-outline-danger"
                                        data-open-not-competent
                                        @(Model.CanReturnNotCompetent ? null : "disabled")>
                                    <span class="material-icons align-middle" style="font-size:16px">block</span>
                                    رفض لعدم الاختصاص
                                </button>
                            </div>
                            @if (Model.CanReturnNotCompetent)
                            {
                                <small class="text-muted d-block mt-2">
                                    استخدم هذا الخيار إذا كان الملف خارج نطاق اختصاص إدارتك. سيتم إرجاع الفكرة إلى المدقق مع تسجيل سبب الرفض.
                                </small>
                            }
                            else
                            {
                                <small class="text-muted d-block mt-2">
                                    لا يمكن الإرجاع لعدم الاختصاص بعد القيام بالتقييم أو طلب رأي جهات أخرى.
                                </small>
                            }
                        </div>
                    </div>
                }

                <div class="card bog-section">
                    <div class="card-header bg-white">
                        <span class="material-icons text-info align-middle">history</span>
                        <strong class="ms-2">السجل الزمني</strong>
                    </div>
                    <div class="card-body">
                        @if (!Model.History.Any())
                        {
                            <p class="text-muted small mb-0">لا توجد تغييرات حالة بعد.</p>
                        }
                        else
                        {
                            <ul class="list-unstyled mb-0 bog-timeline">
                                @foreach (var h in Model.History)
                                {
                                    <li class="mb-3">
                                        <div class="d-flex justify-content-between">
                                            <span>@h.FromStatus → @h.ToStatus</span>
                                            <small class="text-muted" dir="ltr">@h.ChangedAt.FormatDateTime()</small>
                                        </div>
                                        <small class="text-muted">@h.By</small>
                                        @if (!string.IsNullOrWhiteSpace(h.Note))
                                        {
                                            <div class="small mt-1">@h.Note</div>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (canAssess)
{
    <div id="returnNotCompetentModal" class="bog-modal" hidden role="dialog" aria-modal="true"
         aria-labelledby="returnNotCompetentTitle">
        <div class="bog-modal-backdrop" data-close-not-competent></div>
        <div class="bog-modal-dialog bog-modal-dialog-centered" role="document">
            <div class="bog-modal-content">
                <form method="post" asp-action="ReturnNotCompetent" id="returnNotCompetentForm" autocomplete="off">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ideaId" value="@Model.Id" />
                    <h5 id="returnNotCompetentTitle" class="bog-modal-title">
                        <span class="material-icons align-middle text-danger">block</span>
                        رفض لعدم الاختصاص
                    </h5>
                    <p class="bog-modal-body">
                        سيتم إرجاع الفكرة إلى المدقق (<strong>@Model.Reference</strong>) مع تسجيل سبب الرفض.
                        يمكنك بعدها إعادة إحالتها إلى إدارة أخرى من داخل صندوق التدقيق.
                    </p>
                    <label for="notCompetentReason" class="form-label">
                        سبب عدم الاختصاص <span class="text-danger">*</span>
                    </label>
                    <textarea id="notCompetentReason"
                              name="reason"
                              class="form-control mb-3"
                              rows="4"
                              required
                              minlength="10"
                              maxlength="1000"
                              placeholder="اشرح بإيجاز سبب أن الفكرة خارج نطاق اختصاص إدارتك (10 أحرف على الأقل)"></textarea>
                    <div class="form-text mb-3">
                        سيتم تسجيل هذا السبب في سجل الحالات وإظاره للمدقق ليتسنى له إعادة التوجيه.
                    </div>
                    <div class="bog-modal-actions">
                        <button type="button" class="btn btn-outline-secondary" data-close-not-competent>إلغاء</button>
                        <button type="submit"
                                class="btn btn-danger"
                                id="returnNotCompetentSubmit">
                            <span class="material-icons align-middle" style="font-size:16px">undo</span>
                            تأكيد الإرجاع للمدقق
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        (function () {
            var modal = document.getElementById('returnNotCompetentModal');
            if (!modal) return;

            var submitBtn = document.getElementById('returnNotCompetentSubmit');
            var reasonInput = document.getElementById('notCompetentReason');

            function open() {
                modal.hidden = false;
                modal.setAttribute('data-open', 'true');
                if (reasonInput) setTimeout(function () { reasonInput.focus(); }, 50);
            }

            function close() {
                modal.hidden = true;
                modal.removeAttribute('data-open');
                if (reasonInput) {
                    reasonInput.value = '';
                    reasonInput.setCustomValidity('');
                }
                if (submitBtn) {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = '<span class="material-icons align-middle" style="font-size:16px">undo</span> تأكيد الإرجاع للمدقق';
                }
            }

            var openTrigger = document.querySelector('[data-open-not-competent]');
            if (openTrigger) openTrigger.addEventListener('click', open);

            modal.querySelectorAll('[data-close-not-competent]').forEach(function (el) {
                el.addEventListener('click', close);
            });

            function validate() {
                if (!reasonInput) return true;
                var v = (reasonInput.value || '').trim();
                if (v.length < 10) {
                    reasonInput.setCustomValidity('يجب أن يكون السبب 10 أحرف على الأقل.');
                    return false;
                }
                reasonInput.setCustomValidity('');
                return true;
            }

            if (reasonInput) {
                reasonInput.addEventListener('input', validate);
            }

            var form = document.getElementById('returnNotCompetentForm');
            if (form) {
                form.addEventListener('submit', function (e) {
                    if (!validate()) {
                        e.preventDefault();
                        if (reasonInput) reasonInput.reportValidity();
                        return;
                    }
                    if (submitBtn) {
                        submitBtn.disabled = true;
                        submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm align-middle"></span> جاري الإرسال...';
                    }
                });
            }

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && !modal.hidden) close();
            });
        })();
    </script>
}