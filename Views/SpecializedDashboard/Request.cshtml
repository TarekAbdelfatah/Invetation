@model Ibtikar.ViewModels.SpecializedRequestVm
@using Ibtikar.ViewModels
@{
    ViewData["Title"] = $"طلب رأي جهات أخرى · {Model.Reference}";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var partnersJson = System.Text.Json.JsonSerializer.Serialize(
        Model.AvailablePartners.Select(p => new { id = p.Id, name = p.Name, code = p.Code ?? string.Empty })
    );
}

<div class="bog-main">
    <div class="container py-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
            <h2 class="mb-0 d-flex align-items-center gap-2">
                <span class="bog-page-icon" aria-hidden="true">
                    <span class="material-icons">groups</span>
                </span>
                طلب رأي جهات أخرى
            </h2>
            <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.IdeaId">
                <span class="material-icons align-middle" style="font-size:18px">arrow_forward</span>
                العودة للتفاصيل
            </a>
        </div>

        @if (TempData["AlertMessage"] is string ok)
        {
            <div class="alert alert-success">@ok</div>
        }
        @if (TempData["AlertError"] is string err)
        {
            <div class="alert alert-danger">@err</div>
        }

        <div class="card bog-section mb-3">
            <div class="card-body">
                <code class="fs-6">@Model.Reference</code>
                <h1 class="h5 mt-2">@Model.Title</h1>
            </div>
        </div>

        @if (Model.AlreadyAssigned.Any())
        {
            <div class="card bog-section mb-3">
                <div class="card-header bg-white d-flex align-items-center gap-2">
                    <span class="material-icons text-info">history</span>
                    <strong>الجهات التي تم طلب رأيها سابقاً</strong>
                </div>
                <ul class="list-group list-group-flush">
                    @foreach (var p in Model.AlreadyAssigned)
                    {
                        <li class="list-group-item d-flex align-items-center gap-2">
                            <span class="material-icons text-muted">apartment</span>
                            <span>@p.Name</span>
                            <span class="badge bg-secondary ms-auto">مسندة سابقاً</span>
                        </li>
                    }
                </ul>
            </div>
        }

        <form method="post" asp-action="ConfirmRequest" id="request-form" autocomplete="off">
            @Html.AntiForgeryToken()
            <input type="hidden" name="IdeaId" value="@Model.IdeaId" />
            <div data-partner-picker
                 data-max="2"
                 data-partners='@Html.Raw(partnersJson)'>
                <div class="card bog-section mb-3">
                    <div class="card-header bg-white d-flex align-items-center gap-2">
                        <span class="material-icons text-primary">add_business</span>
                        <strong>اختر الجهات لطلب الرأي</strong>
                        <span class="badge bg-secondary ms-auto" data-partner-count>0 / 2</span>
                    </div>
                    <div class="card-body">
                        @if (!Model.AvailablePartners.Any())
                        {
                            <p class="text-muted mb-0">لا توجد جهات متاحة. كل الإدارات النشطة تم طلب رأيها أو مستبعدة.</p>
                        }
                        else
                        {
                            <div class="bog-partner-picker">
                                <div class="bog-partner-picker__search">
                                    <span class="material-icons bog-partner-picker__icon">search</span>
                                    <input type="text"
                                           class="form-control"
                                           placeholder="ابحث عن إدارة لإضافتها…"
                                           data-partner-search
                                           aria-label="ابحث عن إدارة"
                                           aria-autocomplete="list"
                                           aria-controls="partner-suggestions"
                                           disabled="@(Model.AvailablePartners.Count == 0 ? "disabled" : null)" />
                                </div>
                                <ul class="bog-partner-picker__suggestions d-none"
                                    id="partner-suggestions"
                                    role="listbox"
                                    data-partner-suggestions></ul>
                                <small class="text-muted d-block mt-2" data-partner-help>
                                    اكتب اسم الإدارة ثم اخترها من القائمة. الحد الأقصى إدارتان.
                                </small>
                            </div>
                            <div class="text-danger small mt-2" data-partner-error></div>
                        }
                    </div>
                </div>

                <div class="card bog-section mb-3" data-partner-notes-card>
                    <div class="card-header bg-white d-flex align-items-center gap-2">
                        <span class="material-icons text-info">chat_bubble_outline</span>
                        <strong>ملاحظات خاصة بكل جهة</strong>
                    </div>
                    <div class="card-body">
                        <p class="text-muted small mb-3">
                            أضف ملاحظة موجّهة لكل إدارة تطلب رأيها. الملاحظة تظهر للإدارة المستهدفة فقط.
                        </p>
                        <div class="bog-partner-notes" data-partner-notes>
                            <p class="text-muted small mb-0" data-partner-empty>لم يتم اختيار أي إدارة بعد.</p>
                        </div>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2 justify-content-end">
                    <button type="submit"
                            class="btn btn-primary"
                            data-partner-submit
                            @(Model.AvailablePartners.Any() ? null : "disabled")>
                        <span class="material-icons align-middle" style="font-size:18px">send</span>
                        إرسال الطلب
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<template id="bog-partner-note-template">
    <div class="bog-partner-note" data-partner-note>
        <div class="bog-partner-note__head">
            <span class="material-icons text-primary">apartment</span>
            <strong class="bog-partner-note__name" data-partner-name></strong>
            <button type="button"
                    class="btn btn-sm btn-outline-danger ms-auto"
                    data-partner-remove
                    aria-label="إزالة الإدارة">
                <span class="material-icons align-middle" style="font-size:16px">close</span>
                إزالة
            </button>
        </div>
        <textarea class="form-control mt-2"
                  rows="3"
                  maxlength="2000"
                  placeholder="اذكر للإدارة النقاط التي تريد رأيها فيها…"
                  data-partner-note-input></textarea>
    </div>
</template>

@section Scripts {
<script>
    (function () {
        const root = document.querySelector('[data-partner-picker]');
        if (!root) return;

        const maxPartners = parseInt(root.dataset.max || '2', 10);
        let partners = [];
        try {
            partners = JSON.parse(root.dataset.partners || '[]');
        } catch (e) {
            partners = [];
        }

        const search = root.querySelector('[data-partner-search]');
        const suggestions = root.querySelector('[data-partner-suggestions]');
        const notesHost = root.querySelector('[data-partner-notes]');
        const emptyHint = root.querySelector('[data-partner-empty]');
        const countBadge = root.querySelector('[data-partner-count]');
        const errorBox = root.querySelector('[data-partner-error]');
        const submitBtn = root.querySelector('[data-partner-submit]');
        const noteTemplate = document.getElementById('bog-partner-note-template');

        if (!search || !suggestions || !notesHost || !countBadge || !submitBtn || !noteTemplate) return;

        const state = {
            selected: new Map()
        };

        function normalize(s) {
            return (s || '').toString().trim().toLowerCase();
        }

        function isSelected(id) {
            return state.selected.has(id);
        }

        function setError(msg) {
            if (!errorBox) return;
            if (!msg) {
                errorBox.textContent = '';
                errorBox.classList.add('d-none');
                return;
            }
            errorBox.textContent = msg;
            errorBox.classList.remove('d-none');
        }

        function getAvailable() {
            return partners.filter(p => !isSelected(p.id));
        }

        function updateCount() {
            const count = state.selected.size;
            countBadge.textContent = count + ' / ' + maxPartners;
            const reachedMax = count >= maxPartners;
            search.disabled = reachedMax;
            search.placeholder = reachedMax
                ? 'تم اختيار الحد الأقصى (' + maxPartners + ' إدارات)'
                : 'ابحث عن إدارة لإضافتها…';
            submitBtn.disabled = count === 0;
        }

        function renderSuggestions(filter) {
            const term = normalize(filter);
            const matches = partners
                .filter(p => !isSelected(p.id))
                .filter(p => term === '' || normalize(p.name).includes(term) || normalize(p.code).includes(term))
                .slice(0, 8);

            suggestions.innerHTML = '';
            if (matches.length === 0) {
                suggestions.classList.add('d-none');
                return;
            }

            matches.forEach(p => {
                const li = document.createElement('li');
                li.className = 'bog-partner-picker__suggestion';
                li.setAttribute('role', 'option');
                li.dataset.id = p.id;
                li.tabIndex = 0;
                li.innerHTML = '<span class="material-icons text-primary">apartment</span>' +
                    '<span class="bog-partner-picker__suggestion-name"></span>';
                li.querySelector('.bog-partner-picker__suggestion-name').textContent = p.name;
                li.addEventListener('mousedown', function (e) {
                    e.preventDefault();
                    addPartner(p);
                    search.value = '';
                    hideSuggestions();
                });
                li.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter' || e.key === ' ') {
                        e.preventDefault();
                        addPartner(p);
                        search.value = '';
                        hideSuggestions();
                    }
                });
                suggestions.appendChild(li);
            });
            suggestions.classList.remove('d-none');
        }

        function hideSuggestions() {
            suggestions.classList.add('d-none');
            suggestions.innerHTML = '';
        }

        function syncHiddenInputs() {
            root.querySelectorAll('[data-partner-hidden], [data-mirror="true"]').forEach(n => n.remove());

            let i = 0;
            state.selected.forEach((value, id) => {
                const hiddenId = document.createElement('input');
                hiddenId.type = 'hidden';
                hiddenId.name = 'PartnerIds';
                hiddenId.value = id;
                hiddenId.setAttribute('data-partner-hidden', 'id-' + i);
                root.appendChild(hiddenId);

                const hiddenNote = document.createElement('input');
                hiddenNote.type = 'hidden';
                hiddenNote.name = 'Notes[' + i + '].PartnerId';
                hiddenNote.value = id;
                hiddenNote.setAttribute('data-partner-hidden', 'note-id-' + i);
                root.appendChild(hiddenNote);
                i++;
            });

            let noteIdx = 0;
            notesHost.querySelectorAll('[data-partner-note]').forEach(card => {
                const partnerId = card.dataset.partnerId;
                const noteInput = card.querySelector('[data-partner-note-input]');
                if (!partnerId || !noteInput) return;
                const mirror = document.createElement('input');
                mirror.type = 'hidden';
                mirror.name = 'Notes[' + noteIdx + '].Note';
                mirror.value = noteInput.value || '';
                mirror.setAttribute('data-mirror', 'true');
                card.appendChild(mirror);
                noteIdx++;
            });

            while (noteIdx < state.selected.size) {
                const pad = document.createElement('input');
                pad.type = 'hidden';
                pad.name = 'Notes[' + noteIdx + '].Note';
                pad.value = '';
                pad.setAttribute('data-partner-hidden', 'pad-' + noteIdx);
                root.appendChild(pad);
                noteIdx++;
            }
        }

        function addPartner(p) {
            if (!p || isSelected(p.id)) return;
            if (state.selected.size >= maxPartners) {
                setError('لا يمكن طلب رأي أكثر من ' + maxPartners + ' إدارات في المرة الواحدة.');
                return;
            }
            setError('');
            state.selected.set(p.id, { name: p.name, note: '' });

            const node = noteTemplate.content.firstElementChild.cloneNode(true);
            node.dataset.partnerId = p.id;
            node.querySelector('[data-partner-name]').textContent = p.name;
            const removeBtn = node.querySelector('[data-partner-remove]');
            removeBtn.addEventListener('click', function () {
                removePartner(p.id);
            });
            const noteInput = node.querySelector('[data-partner-note-input]');
            noteInput.addEventListener('input', function () {
                const existing = state.selected.get(p.id);
                if (existing) existing.note = noteInput.value;
                syncHiddenInputs();
            });

            if (emptyHint) emptyHint.classList.add('d-none');
            notesHost.appendChild(node);

            updateCount();
            syncHiddenInputs();
        }

        function removePartner(id) {
            state.selected.delete(id);
            const card = notesHost.querySelector('[data-partner-note][data-partner-id="' + id + '"]');
            if (card) card.remove();
            if (state.selected.size === 0 && emptyHint) emptyHint.classList.remove('d-none');
            setError('');
            updateCount();
            syncHiddenInputs();
            renderSuggestions(search.value);
        }

        search.addEventListener('input', function () {
            setError('');
            renderSuggestions(search.value);
        });
        search.addEventListener('focus', function () {
            renderSuggestions(search.value);
        });
        search.addEventListener('blur', function () {
            setTimeout(hideSuggestions, 120);
        });
        search.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
                hideSuggestions();
            }
        });

        document.addEventListener('click', function (e) {
            if (!root.contains(e.target)) hideSuggestions();
        });

        updateCount();
        syncHiddenInputs();
    })();
</script>
}
