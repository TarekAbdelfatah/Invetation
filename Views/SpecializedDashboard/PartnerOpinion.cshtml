@model Ibtikar.ViewModels.SpecializedPartnerOpinionVm
@using Ibtikar.ViewModels
@using static Ibtikar.Services.Helpers.KsaTime
@{
    ViewData["Title"] = $"ردود الجهات المستشارة · {Model.Reference}";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="bog-main">
    <div class="container py-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
            <h2 class="mb-0 d-flex align-items-center gap-2">
                <span class="bog-page-icon" aria-hidden="true">
                    <span class="material-icons">forum</span>
                </span>
                متابعة ردود الجهات المستشارة
            </h2>
            <div class="d-flex gap-2">
                <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.IdeaId">
                    <span class="material-icons align-middle" style="font-size:18px">arrow_forward</span>
                    تفاصيل
                </a>
                <a class="btn btn-primary" asp-action="Request" asp-route-id="@Model.IdeaId">
                    <span class="material-icons align-middle" style="font-size:18px">add</span>
                    إضافة جهات أخرى
                </a>
            </div>
        </div>

        <div class="card bog-section mb-3">
            <div class="card-body">
                <code class="fs-6">@Model.Reference</code>
                <h1 class="h5 mt-2">@Model.Title</h1>
            </div>
        </div>

        @if (!Model.Rows.Any())
        {
            <div class="card bog-section">
                <div class="card-body text-center text-muted p-5">
                    <span class="material-icons" style="font-size:48px;color:var(--text-muted)">forum</span>
                    <p class="mb-1 mt-2">لم يتم إرسال أي طلب لجهات أخرى بعد.</p>
                    <a class="btn btn-primary mt-3" asp-action="Request" asp-route-id="@Model.IdeaId">
                        <span class="material-icons align-middle" style="font-size:18px">groups</span>
                        طلب رأي جهات أخرى
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="card bog-section">
                <div class="card-header bg-white d-flex align-items-center gap-2">
                    <span class="material-icons text-primary">inventory_2</span>
                    <strong>الجهات المستشارة وردودها</strong>
                    <span class="badge bg-secondary ms-auto">@Model.Rows.Count</span>
                </div>
                <div class="table-responsive">
                    <table class="bog-card-list mb-0">
                        <thead>
                            <tr>
                                <th>الجهة المستشارة</th>
                                <th>الحالة</th>
                                <th>منذ الطلب</th>
                                <th>الرد (تعليق الإدارة)</th>
                                <th>التقييم (الملاحظات)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model.Rows)
                            {
                                <tr class="@(r.IsLate ? "table-warning" : null)">
                                    <td data-label="الجهة المستشارة">
                                        <span class="material-icons text-muted align-middle">apartment</span>
                                        @r.PartnerDepartmentName
                                    </td>
                                    <td data-label="الحالة">
                                        <span class="badge @r.StatusBadgeClass">@r.Status</span>
                                    </td>
                                    <td data-label="منذ الطلب">
                                        <small dir="ltr">@Math.Ceiling(r.DaysOpen).ToString("0") يوم</small>
                                        @if (r.IsLate)
                                        {
                                            <span class="badge bg-danger ms-1">متأخر (أكثر من 4 أيام)</span>
                                        }
                                    </td>
                                    <td data-label="الرد" class="small">
                                        @if (r.HasResponse)
                                        {
                                            <div class="d-flex align-items-center gap-2 mb-1">
                                                <span class="badge bg-success">تم الرد</span>
                                                @if (r.TotalScore.HasValue)
                                                {
                                                    <span class="badge bg-primary">إجمالي: @r.TotalScore</span>
                                                }
                                                @if (r.ResponseSubmittedAt.HasValue)
                                                {
                                                    <small class="text-muted" dir="ltr">@r.ResponseSubmittedAt.Value.FormatDateTime()</small>
                                                }
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(r.ResponseComment))
                                            {
                                                <div class="text-break" style="white-space:pre-line">@r.ResponseComment</div>
                                            }
                                            else
                                            {
                                                <span class="text-muted">(لم تُرفق ملاحظة)</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted small">لم يرد بعد</span>
                                        }
                                    </td>
                                    <td data-label="التقييم" class="small">
                                        @if (r.HasResponse && r.Scores.Any())
                                        {
                                            <ul class="list-unstyled mb-0 bog-partner-scores">
                                                @foreach (var s in r.Scores)
                                                {
                                                    <li class="bog-partner-score-line">
                                                        <div class="d-flex align-items-center gap-2">
                                                            <span class="bog-partner-score-line__name">@s.CriterionName</span>
                                                            <span class="badge bg-primary ms-auto">@s.Score</span>
                                                        </div>
                                                        @if (!string.IsNullOrWhiteSpace(s.Comment))
                                                        {
                                                            <div class="text-muted text-break mt-1" style="white-space:pre-line">@s.Comment</div>
                                                        }
                                                    </li>
                                                }
                                            </ul>
                                        }
                                        else if (r.HasResponse)
                                        {
                                            <span class="text-muted small">تم الرد دون تقييم مفصّل.</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .bog-partner-scores {
        display: flex;
        flex-direction: column;
        gap: 8px;
        max-width: 360px;
    }
    .bog-partner-score-line {
        padding: 6px 10px;
        background: var(--gray-50, #f8f9fa);
        border: 1px solid var(--border-light, #ECECED);
        border-radius: var(--radius-md, 8px);
    }
    .bog-partner-score-line__name {
        font-weight: 600;
        color: var(--text-primary);
    }
</style>
