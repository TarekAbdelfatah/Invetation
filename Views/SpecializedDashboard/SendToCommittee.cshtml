@model Ibtikar.ViewModels.SpecializedSendToCommitteeVm
@{
    ViewData["Title"] = $"إرسال إلى اللجنة · {Model.Reference}";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="bog-main">
    <div class="container py-4">
        <div class="bog-page-header">
            <h1>
                <span class="bog-page-icon" aria-hidden="true">
                    <span class="material-icons">how_to_reg</span>
                </span>
                إرسال إلى لجنة الابتكار
            </h1>
            <span class="bog-page-role">
                <code>@Model.Reference</code>
            </span>
        </div>

        @if (TempData["PartnerWarning"] is string warn)
        {
            <div class="alert alert-warning d-flex align-items-start gap-2">
                <span class="material-icons">warning</span>
                <div>@warn</div>
            </div>
        }
        @if (TempData["AlertError"] is string err)
        {
            <div class="alert alert-danger">@err</div>
        }

        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="card h-100 bog-kpi-card">
                    <div class="card-body">
                        <div class="bog-kpi-label">المعايير المُقيَّمة</div>
                        <div class="bog-kpi-value text-primary">@Model.CompletedCriteria / @Model.TotalCriteria</div>
                        <div class="bog-kpi-meta">@(Model.CanSend ? "جاهز للإرسال" : "يجب إكمال المعايير")</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 bog-kpi-card">
                    <div class="card-body">
                        <div class="bog-kpi-label">شركاء بانتظار الرد</div>
                        <div class="bog-kpi-value @(Model.UnrepliedPartners > 0 ? "text-warning" : "text-success")">
                            @Model.UnrepliedPartners
                        </div>
                        <div class="bog-kpi-meta">@(Model.UnrepliedPartners > 0 ? "غير محسوم" : "كل الشركاء ردّوا")</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 bog-kpi-card">
                    <div class="card-body">
                        <div class="bog-kpi-label">الإجراء</div>
                        <div class="bog-kpi-value @(Model.CanSend ? "text-success" : "text-danger")">
                            @(Model.CanSend ? "متاح" : "محظور")
                        </div>
                        <div class="bog-kpi-meta">@(Model.UnrepliedPartners > 0 ? "يحتاج تأكيد" : "مباشر")</div>
                    </div>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.WarningMessage))
        {
            <div class="alert alert-warning">
                <strong>تنبيه:</strong> @Model.WarningMessage
            </div>
        }

        <form method="post" asp-action="ConfirmSendToCommittee" id="send-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ideaId" value="@Model.IdeaId" />
            @if (Model.UnrepliedPartners > 0)
            {
                <input type="hidden" name="skipPartnerWarning" value="true" />
                <p class="text-muted">بسبب وجود @(Model.UnrepliedPartners) شريك لم يرد، سيتم إرسال الطلب إلى اللجنة مباشرة بعد تأكيدك.</p>
            }
            else
            {
                <input type="hidden" name="skipPartnerWarning" value="false" />
            }

            <div class="d-flex flex-wrap gap-2 justify-content-end">
                <a class="btn btn-outline-secondary" asp-action="Assess" asp-route-id="@Model.IdeaId">
                    <span class="material-icons align-middle" style="font-size:18px">edit_note</span>
                    رجوع للتقييم
                </a>
                <button type="submit" class="btn btn-success" @(Model.CanSend ? null : "disabled")>
                    <span class="material-icons align-middle" style="font-size:18px">send</span>
                    @(Model.UnrepliedPartners > 0 ? "إرسال رغم تحذير الشركاء" : "إرسال إلى اللجنة")
                </button>
            </div>
        </form>
    </div>
</div>