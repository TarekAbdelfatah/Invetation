@{
    var year = DateTime.UtcNow.Year;
}

<footer class="bog-footer text-white">
    <div class="container py-4">
        <div class="row gy-4">
            <div class="col-lg-5">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <img src="~/img/BOG_Logo_Shape.svg" alt="" class="bog-logo-shape" aria-hidden="true" />
                    <div class="d-flex flex-column">
                        <span class="fw-bold fs-5">ابتكار</span>
                        <small class="opacity-75">بوابة الأفكار الابتكارية</small>
                    </div>
                </div>
                <p class="opacity-75 mb-0" style="max-width: 320px;">
                    منصة رسمية لإدارة دورة حياة الأفكار الابتكارية من التقديم حتى الاعتماد والتنفيذ داخل الجهة.
                </p>
            </div>

            <div class="col-lg-4 col-md-6">
                <h6 class="fw-bold mb-3">روابط سريعة</h6>
                <ul class="list-unstyled bog-footer-links m-0">
                    <li><a asp-controller="Home" asp-action="Index">الرئيسية</a></li>
                    <li><a asp-controller="Ideas" asp-action="Create">تقديم فكرة</a></li>
                    <li><a asp-controller="Ideas" asp-action="Index">سجل الأفكار</a></li>
                    <li><a asp-controller="MyRequests" asp-action="Index">طلباتي</a></li>
                </ul>
            </div>

            <div class="col-lg-3 col-md-6">
                <h6 class="fw-bold mb-3">الدعم</h6>
                <ul class="list-unstyled bog-footer-links m-0">
                    <li><span class="opacity-75">البريد:</span> <a href="mailto:ibtikar-support@example.local">ibtikar-support@example.local</a></li>
                    <li><span class="opacity-75">ساعات العمل:</span> ٨ص — ٤م</li>
                </ul>
            </div>
        </div>

        <hr class="my-4 opacity-25" />

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
            <small class="opacity-75">© @year - ابتكار - جميع الحقوق محفوظة</small>
            <small class="opacity-75 d-inline-flex align-items-center gap-1">
                <span class="material-icons" style="font-size:14px">verified</span>
                منصة معتمدة داخل الجهة
            </small>
        </div>
    </div>
</footer>
