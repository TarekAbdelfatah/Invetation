@using Ibtikar.Services.Helpers
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    string IsActive(string controller, string action = "Index") =>
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) &&
        string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase)
            ? "active"
            : string.Empty;

    var isAuth = User.Identity?.IsAuthenticated == true;
    var fullName = isAuth ? User.FindFirst(RoleCodes.FullNameClaim)?.Value : null;
    var departmentName = isAuth ? User.FindFirst(RoleCodes.DepartmentNameClaim)?.Value : null;
    var isInternal = isAuth && !string.IsNullOrEmpty(User.FindFirst(RoleCodes.DepartmentIdClaim)?.Value);
    var roleClaims = isAuth
                     ? User.FindAll(RoleCodes.ClaimType).Select(c => c.Value).ToHashSet(StringComparer.OrdinalIgnoreCase)
                     : new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    var hasAnyRoleClaim = roleClaims.Count > 0;
    var showAdmin = isAuth && roleClaims.Contains(RoleCodes.SystemAdmin);
    var showIdeasIndex = isAuth && roleClaims.Contains(RoleCodes.SystemAdmin);
    var showMyRequests = isAuth
                         && (roleClaims.Contains(RoleCodes.ExternalBeneficiary)
                             || roleClaims.Contains(RoleCodes.InternalBeneficiary)
                             || !hasAnyRoleClaim);
    var showAudit = isAuth && roleClaims.Contains(RoleCodes.AuditEmployee);

    string HomeController()
    {
        if (!isAuth) return "Home";
        if (roleClaims.Contains(RoleCodes.SystemAdmin)) return "AdminOverview";
        if (roleClaims.Contains(RoleCodes.AuditEmployee)) return "Audit";
        if (roleClaims.Contains(RoleCodes.SpecializedDepartment) || roleClaims.Contains(RoleCodes.PartnerDepartment)) return "SpecializedDashboard";
        if (roleClaims.Contains(RoleCodes.InnovationCommitteeMember)) return "Committee";
        return "MyRequests";
    }
    var homeController = HomeController();
    var homeAction = "Index";
}

<header class="bog-header">
    <div class="container">
        <div class="bog-header-row">
            <a class="bog-brand" asp-controller="@homeController" asp-action="@homeAction" aria-label="ابتكار">
                <img src="~/img/BOG_Logo.svg" alt="بوابة ديوان المظالم - ابتكار" />
                <span class="bog-brand-text">
                    <span class="bog-brand-title">ابتكار</span>
                    <small class="bog-brand-sub">بوابة الأفكار الابتكارية</small>
                </span>
            </a>

            @if (isAuth)
            {
                <button class="bog-header-toggle" type="button"
                        aria-controls="mainNav" aria-expanded="false" aria-label="تبديل التنقل"
                        onclick="var n=document.getElementById('mainNav');var o=n.classList.toggle('is-open');this.setAttribute('aria-expanded',String(o));">
                    <span class="material-icons">menu</span>
                </button>

                <div class="bog-header-collapse" id="mainNav">
                    <nav class="bog-nav" aria-label="التنقل الرئيسي">
                        @if (showAdmin)
                        {
                            <a class="bog-nav-link @IsActive("AdminOverview")" asp-controller="AdminOverview" asp-action="Index">
                                <span class="material-icons" aria-hidden="true">dashboard</span>
                                نظرة عامة
                            </a>
                        }
                        @if (showIdeasIndex)
                        {
                            <a class="bog-nav-link @IsActive("Ideas")" asp-controller="Ideas" asp-action="Index">
                                <span class="material-icons" aria-hidden="true">lightbulb</span>
                                سجل الأفكار
                            </a>
                        }
                        @if (showMyRequests)
                        {
                            <a class="bog-nav-link @IsActive("MyRequests")" asp-controller="MyRequests" asp-action="Index">
                                <span class="material-icons" aria-hidden="true">folder</span>
                                طلباتي
                            </a>
                        }
                        @if (showAudit)
                        {
                            <a class="bog-nav-link @IsActive("Audit")" asp-controller="Audit" asp-action="Inbox">
                                <span class="material-icons" aria-hidden="true">fact_check</span>
                                صندوق التدقيق
                            </a>
                        }
                    </nav>

                    <div class="bog-auth">
                        <span class="bog-user-chip" title="@(isInternal ? departmentName : fullName)">
                            <span class="material-icons" aria-hidden="true">account_circle</span>
                            <span class="bog-user-meta">
                                <span class="bog-user-name">@fullName</span>
                                @if (isInternal && !string.IsNullOrWhiteSpace(departmentName))
                                {
                                    <small class="bog-user-role">@departmentName</small>
                                }
                            </span>
                        </span>
                        <form method="post" asp-controller="Account" asp-action="Logout" class="bog-logout-form">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-secondary btn-sm">
                                <span class="material-icons align-middle" style="font-size:18px">logout</span>
                                <span>خروج</span>
                            </button>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <a class="btn btn-primary btn-sm bog-header-login" asp-controller="Account" asp-action="Login">
                    <span class="material-icons align-middle" style="font-size:18px">login</span>
                    دخول
                </a>
            }
        </div>
    </div>
</header>
