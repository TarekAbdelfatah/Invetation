@model dynamic
@{
    var ideaId = (Guid)Model.Id;
    var ideaRef = (string)(Model.ReferenceNumber ?? string.Empty);
    var title = (string)(Model.Title ?? string.Empty);
    bool isDraft = ideaId == Guid.Empty || string.IsNullOrEmpty(ideaRef);
    bool isReadOnly = (bool)(Model.ReadOnly ?? false);
    string uploadEndpoint = isDraft
        ? $"/api/Attachment/uploadDraft?draftId={ideaId}"
        : "/api/Attachment/upload";
    string listEndpoint = isDraft
        ? $"/api/Attachment/listDraft?draftId={ideaId}"
        : $"/api/Attachment/list?ideaId={ideaId}";
    string uploadField = isDraft ? "draftId" : "ideaId";
}

<div style="display:none">@Html.AntiForgeryToken()</div>

<section class="py-4">
    <div class="container">
        <div class="card bog-section"
             data-idea-id="@ideaId"
             @(isDraft ? "data-draft-mode=true" : "data-real-idea=true")
             data-upload-endpoint="@uploadEndpoint"
             data-list-endpoint="@listEndpoint"
             data-upload-field="@uploadField"
             data-read-only="@(isReadOnly.ToString().ToLowerInvariant())">
            <div class="card-header bg-white">
                <strong><i class="bi bi-paperclip"></i>
                    @(isReadOnly ? "المرفقات" : "المرفقات (PDF فقط، حتى ملفين، 5 ميجا لكل ملف)")
                </strong>
                @if (!string.IsNullOrEmpty(title))
                {
                    <small class="text-muted ms-2">الفكرة: @title</small>
                }
            </div>
            <div class="card-body">
                @if (!isReadOnly)
                {
                    <div class="d-flex flex-wrap gap-2 align-items-center mb-3" data-attachments-toolbar="true">
                        <input type="file" class="form-control form-control-sm" style="max-width:320px"
                               accept="application/pdf" data-attachments-input="true" />
                        <button type="button" class="btn btn-primary btn-sm" data-attachments-upload="true">
                            <i class="bi bi-cloud-upload"></i> رفع الملف
                        </button>
                        <small class="text-muted" data-attachments-status="true">لم يتم اختيار ملف.</small>
                    </div>
                    <div class="progress d-none" data-attachments-progress="true" style="height:6px;">
                        <div class="progress-bar" role="progressbar" style="width:0%"></div>
                    </div>
                }
                <ul class="list-group mt-3" data-attachments-list="true"></ul>
            </div>
        </div>
    </div>
</section>

<script src="~/js/idea-attachments.js" asp-append-version="true"></script>
