@{
    var suppressGlobalAlert = ViewData["SuppressGlobalAlert"] is true;
    var alertMessage = string.Empty;
    var alertType = "info";

    if (!suppressGlobalAlert)
    {
        if (TempData["AlertMessage"] is string am)
        {
            alertMessage = am;
            alertType = TempData["AlertType"] as string ?? "info";
        }
        else if (TempData["IdeaDeleted"] is string d)
        {
            alertMessage = d;
            alertType = "success";
        }
        else if (TempData["IdeaResubmitted"] is string r)
        {
            alertMessage = r;
            alertType = "success";
        }
        else if (TempData["IdeaDraftSaved"] is string s)
        {
            alertMessage = s;
            alertType = "success";
        }
    }

    if (!string.IsNullOrEmpty(alertMessage))
    {
        ViewData["Type"] = alertType;
        ViewData["Dismissible"] = true;
    }
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - أبتكر</title>

    <link rel="icon" type="image/png" href="~/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/css/bog-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/mobile.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/details.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/partner.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/loading.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Ibtikar.styles.css" asp-append-version="true" />
</head>
<body class="bog-app">
    <a class="visually-hidden-focusable" href="#main-content">تخطي إلى المحتوى الرئيسي</a>
    <partial name="_Header" />

    <main id="main-content" role="main" class="bog-main">
        @if (!string.IsNullOrEmpty(alertMessage))
        {
            <div class="container pt-3 position-relative" style="z-index:1050">
                @await Html.PartialAsync("_Alert", alertMessage)
            </div>
        }
        @RenderBody()
    </main>

    <partial name="_ConfirmModal" />
    <partial name="_Footer" />

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/loading.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
